{
  "tool_id": "doc-staleness-adapter",
  "kind": "adapter",
  "version": "1.0.0",
  "status": "SHADOW",
  "security_class": false,
  "declared_scope": [
    "docs/**/*.md",
    "apps/**/*.md",
    "libs/**/*.md",
    "web/**/*.md",
    "infra/**/*.md",
    "infrastructure/**/*.md",
    "e2e/**/*.md",
    "platform/**/*.md",
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CLAUDE.md"
  ],
  "output_schema": {
    "type": "object",
    "required": ["observations", "findings", "read_paths", "evidence_sources"]
  },
  "fixture_set": "tools/aria-adapters/fixtures/doc-staleness-adapter",
  "health_thresholds": {
    "max_cost_units": 4000
  },
  "default_input": {
    "roots": [
      "docs",
      "apps",
      "libs",
      "web",
      "infra",
      "infrastructure",
      "e2e",
      "platform",
      "README.md",
      "AGENTS.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "CLAUDE.md"
    ]
  },
  "allowed_read_globs": [
    "docs/**/*.md",
    "apps/**/*.md",
    "libs/**/*.md",
    "web/**/*.md",
    "infra/**/*.md",
    "infrastructure/**/*.md",
    "e2e/**/*.md",
    "platform/**/*.md",
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CLAUDE.md"
  ],
  "forbidden_read_globs": [
    ".claude/**",
    ".git/**",
    "agent-workspace/**",
    ".aria-poc/**",
    "aria-tools/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "build/**",
    "tmp/**"
  ],
  "claim_types": ["doc_staleness"],
  "rules": {
    "doc_references_missing_path": {
      "claim_type": "currency_gap",
      "severity_cap": "MEDIUM",
      "defect_claim": "A document describes a repository path that no longer exists, so a reader is pointed at a surface that is gone.",
      "premises": [
        "The cited line names the path as an existing part of the repository, not as a file to create, a removed file or a historical record.",
        "The path does not exist in the repository at the judged commit, and no file it was renamed to is named beside it."
      ],
      "observable": {
        "kind": "referenced_path_absent_at_sha"
      }
    }
  },
  "owner": "platform",
  "runner": {
    "type": "subprocess",
    "argv": [
      "npx",
      "ts-node",
      "--project",
      "tools/gates/tsconfig.json",
      "tools/aria-adapters/doc-staleness-adapter.ts"
    ],
    "cwd": ".",
    "timeout_ms": 180000,
    "stdin_json": true
  },
  "freshness_window_hours": 168,
  "parse_window_signature": "sha256:3315a963accdd322518658e0fc8190b0bff852644e8d9e1b610a46b494c7f730",
  "schema_version": 1
}
