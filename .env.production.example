# =============================================================================
# Aquaculture Platform - Production Environment Variables
# Copy this file to .env on your server and fill in the values
#
# cp .env.production.example .env
# nano .env
# =============================================================================

# --- Database ---
POSTGRES_USER=aquaculture
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=aquaculture

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- JWT ---
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string
JWT_EXPIRES_IN=1h

# --- Encryption ---
ENCRYPTION_KEY=CHANGE_ME_32_char_hex_string

# --- MFA & WebAuthn ---
# MFA encryption key for TOTP secret storage (AES-256-GCM)
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=CHANGE_ME_64_char_hex_string

# WebAuthn Relying Party configuration
# RP_ID must match your domain (without protocol or port)
WEBAUTHN_RP_ID=app.suderra.com
WEBAUTHN_RP_NAME=Suderra Aquaculture Platform

# --- Per-service Database Passwords (SEC-015) ---
# Used by 00-init-schemas.sh to create per-service DB roles.
# If left empty, random passwords are generated at first DB init.
# For production, set these explicitly and store them securely.
# Generate with: openssl rand -base64 32
AUTH_SERVICE_DB_PASS=
FARM_SERVICE_DB_PASS=
SENSOR_SERVICE_DB_PASS=
BILLING_SERVICE_DB_PASS=
HR_SERVICE_DB_PASS=
ALERT_SERVICE_DB_PASS=
ADMIN_SERVICE_DB_PASS=
GATEWAY_SERVICE_DB_PASS=
NOTIFICATION_SERVICE_DB_PASS=
HYDROPONICS_SERVICE_DB_PASS=

# --- Email (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# --- Farm Water Chemistry ---
# Vite reads these at build time. Set chart mode to legacy before building a
# rollback artifact; changing this on an already-built static bundle has no effect.
VITE_DEFFEYES_CHART_MODE=ph
VITE_DEFFEYES_ALLOW_DIAGNOSTIC_MODE_OVERRIDE=false
