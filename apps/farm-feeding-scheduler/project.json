{
  "name": "farm-feeding-scheduler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/farm-feeding-scheduler/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:worker"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/farm-feeding-scheduler"],
      "defaultConfiguration": "production",
      "options": {
        "command": "bash tools/build/build-service.sh farm-feeding-scheduler"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "farm-feeding-scheduler:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "farm-feeding-scheduler:build:development"
        },
        "production": {
          "buildTarget": "farm-feeding-scheduler:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/farm-feeding-scheduler/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/farm-feeding-scheduler/jest.config.ts"
      }
    }
  }
}
