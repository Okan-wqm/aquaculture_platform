# syntax=docker/dockerfile:1.4
# =============================================================================
# aqua-db-migrate — one-shot schema migration runner.
# WS10 / ADR-016 Phase E — Phase 1 (backward-compatible).
#
# Usage:
#   docker compose -f docker-compose.droplet.yml up --exit-code-from aqua-db-migrate
#
# This image exists to isolate schema-level migrations from per-service
# bootstrap. With 14 services restarting in parallel on
# OnApplicationBootstrap, race conditions on shared resources (shared-
# schema RLS install, source-schema DDL feeding tenant-clone, TimescaleDB
# hypertable continuous-aggregate creation) become real. A dedicated
# one-shot container owns that contention window.
#
# Phase 1 boundary: this container runs ALONGSIDE every service's own
# createMigrationRunnerService. If this container fails, services still
# boot (their own runners re-apply the same migrations, idempotently).
# Phase 2 removes per-service runners — requires staging-first
# validation (WS9 / TRACKED-DEPLOY-003).
#
# Same base + hardening posture as Dockerfile.backend.simple so the
# image is reviewable under the same security rules.
# =============================================================================
FROM node:22.13.1-bookworm-slim AS base

# dumb-init as PID 1 for correct SIGTERM delivery when compose tears down
# the one-shot container. curl is kept only for pre-start connectivity
# checks operators may want to run via `docker exec`.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl dumb-init && \
    rm -rf /var/lib/apt/lists/*

# Non-root user identical to the per-service images so the container's
# filesystem ownership matches if someone shells in for debugging.
RUN groupadd --gid 1001 nodejs && \
    useradd --uid 1001 --gid nodejs --no-create-home --shell /bin/sh nestjs

WORKDIR /app

# Match backend service image npm retry behavior. The db-migrate image is built
# in the same deploy matrix and should tolerate transient registry resets the
# same way as service images.
ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    NPM_CONFIG_FETCH_TIMEOUT=300000 \
    NPM_CONFIG_FUND=false

# Production-only dependency install — typeorm + pg + reflect-metadata
# are in the root package.json so installing production deps here
# pulls everything this container needs.
COPY package*.json ./
# The root production graph contains this repository-local package. npm links
# file dependencies instead of copying them, so its target must be part of the
# immutable image before dependency installation.
COPY --chown=nestjs:nodejs tools/vendor/apollo-playground-disabled ./tools/vendor/apollo-playground-disabled
RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    npm ci --omit=dev --ignore-scripts --no-audit && \
    npm ls --omit=dev --all >/dev/null && \
    node -e "require('@apollo/server-plugin-landing-page-graphql-playground')" && \
    chown -R nestjs:nodejs /app/node_modules

# Bundle layout: host-built dist/apps/db-migrate/* mirrors the same
# "main.js is a shim pointing at apps/db-migrate/src/main.js" convention
# that every service uses — see tools/build/build-service.sh.
COPY --chown=nestjs:nodejs dist/apps/db-migrate ./dist

# ADR-031: platform-bootstrap SQL files travel with the binary.
# resolvePlatformBootstrapSqlDir() in platform-bootstrap.service.ts
# expects them at dist/apps/db-migrate/src/sql/platform-bootstrap/.
# The host build copies the .ts compilation output but NOT the .sql
# siblings, so the COPY below brings them in directly from source.
# Source-of-truth: apps/db-migrate/src/sql/platform-bootstrap/*.sql.
COPY --chown=nestjs:nodejs apps/db-migrate/src/sql ./dist/apps/db-migrate/src/sql

ENV NODE_ENV=production

# No HEALTHCHECK — this is a one-shot container. The deploy workflow
# gates on `service_completed_successfully` via compose depends_on,
# not on a healthcheck poll.

USER nestjs

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
