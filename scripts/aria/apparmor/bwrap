# ARIA runner (Ubuntu 24.04): kernel.apparmor_restrict_unprivileged_userns=1
# denies user-namespace creation to unconfined binaries, so bubblewrap run by
# the unprivileged runner user (gharunner) failed with "setting up uid map:
# Permission denied" / "loopback: Failed RTM_NEWADDR" while it worked as root.
# Same shape as Ubuntu's own userns grants (ch-checkns, lxc-usernsexec,
# unshare): name the binary, grant userns, confine nothing else.
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/bwrap>
}
