{
  "tool_id": "typeorm-entity-schema-adapter",
  "kind": "adapter",
  "version": "1.1.0",
  "status": "SHADOW",
  "declared_scope": ["apps/**/*.ts", "libs/backend-common/src/database/schema-manager.service.ts"],
  "output_schema": {
    "type": "object",
    "required": ["observations", "findings", "read_paths", "evidence_sources"]
  },
  "fixture_set": "tools/aria-adapters/fixtures/typeorm-entity-schema-adapter",
  "health_thresholds": {
    "max_cost_units": 2000
  },
  "allowed_read_globs": [
    "apps/**/*.ts",
    "libs/backend-common/src/database/schema-manager.service.ts"
  ],
  "forbidden_read_globs": [
    ".claude/**",
    ".git/**",
    "agent-workspace/**",
    ".aria-poc/**",
    "aria-tools/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "build/**",
    "tmp/**"
  ],
  "claim_types": ["schema_drift"],
  "owner": "platform",
  "runner": {
    "type": "subprocess",
    "argv": [
      "npx",
      "ts-node",
      "--project",
      "tools/gates/tsconfig.json",
      "tools/aria-adapters/typeorm-entity-schema-adapter.ts"
    ],
    "cwd": ".",
    "timeout_ms": 180000,
    "stdin_json": true
  },
  "schema_version": 1
}
