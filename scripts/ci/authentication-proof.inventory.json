        "node_modules/jest/bin/jest.js",
        "--config",
        "libs/backend-common/jest.config.ts",
        "--runInBand",
        "--no-cache",
        "--json",
        "--outputFile=artifacts/authentication-proof/nats-client-policy.json",
        "--runTestsByPath",
        "libs/backend-common/src/nats/__tests__/nats-connection.factory.spec.ts",
        "libs/backend-common/src/nats/__tests__/nats-v3-client.proxy.spec.ts",
        "libs/backend-common/src/nats/__tests__/nats-response-policy.spec.ts"
