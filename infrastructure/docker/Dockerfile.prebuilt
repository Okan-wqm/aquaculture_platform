# syntax=docker/dockerfile:1.4
# =============================================================================
# Dockerfile.prebuilt - Uses pre-built dist from local machine
# For fast development iterations - skips nx build (still needs npm ci)
#
# Usage: docker build -f infrastructure/docker/Dockerfile.prebuilt \
#        --build-arg SERVICE_NAME=sensor-service -t sensor-service:dev .
# =============================================================================

# Stage 1: Install production dependencies
FROM node:22-alpine AS deps

WORKDIR /app
COPY package*.json ./

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --legacy-peer-deps --omit=dev --ignore-scripts --no-audit

# Stage 2: Production image
FROM node:22-alpine AS production

# Install runtime dependencies
RUN apk add --no-cache curl dumb-init

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001

WORKDIR /app

# Copy production dependencies with correct ownership
COPY --from=deps --chown=nestjs:nodejs /app/node_modules ./node_modules

# Copy pre-built dist from local machine
ARG SERVICE_NAME
COPY --chown=nestjs:nodejs dist/apps/${SERVICE_NAME}/ ./dist/
COPY --chown=nestjs:nodejs package.json ./

USER nestjs

# Environment
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl --fail --silent http://127.0.0.1:3000/health/live || exit 1

# Start
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
