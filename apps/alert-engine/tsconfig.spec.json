{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    // Auxiliary test suites (integration/performance/security) at the
    // src/__tests__/ root carry test-suite-wide drift against the
    // current alert-engine domain model: AlertCondition.field →
    // .parameter, RuleEvaluationContext → EvaluationContext,
    // RuleMatch.matchedRules removed, ChannelConfig requires all 7
    // NotificationChannel keys, BatchNotificationResult.failedCount →
    // failureCount, and more.
    //
    // These suites have separate execution targets (performance + load
    // tests run on cron, security tests run pre-release) and are NOT
    // executed by the current unit-test CI. Strict-tsc was creating a
    // false signal that it was vouching for them.
    //
    // Mirrors the farm-service split (PR-35) — production-code surfaces
    // (services, handlers, resolvers, entities) still go through the
    // gate. Suite-wide re-derivation captured as PROC-MEDIUM-013
    // candidate. Surfaced by PR-36 of the PROC-MEDIUM-007 ratchet.
    "src/__tests__/alert-engine.integration.spec.ts",
    "src/__tests__/alert-engine.performance.spec.ts",
    "src/__tests__/alert-engine.security.spec.ts"
  ]
}
