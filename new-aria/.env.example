# Copy to .env next to docker-compose.yml. Every value here is read by
# docker-compose.yml or by the executor (tools/aria-poc/claude_runtime.py).
# 1 = fixture path, no Claude Code login needed. 0 = live `claude -p` (requires a
# managed Claude Code login session inside the container: mount ~/.claude).
CLAUDE_CLI_MOCK=1
ARIA_CLAUDE_REQUIRE_USAGE=1
# Repository ARIA observes; defaults to this folder.
ARIA_WORKSPACE=.
# Claude Code CLI version baked into the image (build arg).
CLAUDE_CODE_VERSION=2.1.259
# Fine-grained PAT for PR lanes (gh). Leave empty when not opening PRs.
ARIA_GH_TOKEN=
# Operator console (ui/): token every /api call must carry; generate with
# `openssl rand -hex 32`. Bind/port of the published console.
ARIA_UI_TOKEN=
ARIA_UI_PORT=8480
ARIA_UI_BIND=0.0.0.0
# 1 enables mutating console actions (control pause/resume, cycle run).
ARIA_UI_ALLOW_ACTIONS=0
# Workspace the console hands to kernel actions; use /data/seed-workspace when
# ARIA_WORKSPACE is not a git repository root (the seed profile then observes a
# committed copy of this tree under /data).
ARIA_UI_WORKSPACE_ROOT=/workspace
