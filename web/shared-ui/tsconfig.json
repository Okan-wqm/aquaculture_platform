{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Build */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@aquaculture/shared-contracts": ["../../libs/shared-contracts/src/index.ts"],
      "@platform/admin-http-contracts": ["../../platform/libs/admin-http-contracts/src/index.ts"],
      "@platform/event-contracts": ["../../libs/event-contracts/src/index.ts"],
      "@platform/identity": ["../../libs/event-contracts/src/roles.ts"],
      "@platform/tenant-permissions": ["../../libs/event-contracts/src/tenant-permissions.ts"],
      "@platform/pagination-contracts": ["../../platform/libs/pagination-contracts/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-setup.ts"
  ]
}
