{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sens Enterprise Validation Claims",
  "type": "object",
  "required": ["version", "metadata", "claims"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "metadata": {
      "type": "object",
      "required": ["plan_id", "plan_path", "reviewed_at", "release_gate", "claim_schema"],
      "additionalProperties": false,
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "plan_path": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "minLength": 1 },
        "release_gate": { "const": true },
        "claim_schema": { "type": "string", "minLength": 1 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "owner",
          "risk_tier",
          "release_blocker",
          "evidence_type",
          "evidence_class",
          "command",
          "expected_exit",
          "checks",
          "plan_refs",
          "evidence_refs",
          "linked_finding_id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["closed", "blocked", "fail"] },
          "owner": { "type": "string", "minLength": 1 },
          "risk_tier": { "enum": ["P0", "P1", "P2", "P3"] },
          "release_blocker": { "type": "boolean" },
          "evidence_type": { "enum": ["static", "behavioral", "hil"] },
          "evidence_class": {
            "enum": [
              "workflow_static",
              "static_analysis",
              "code_and_unit",
              "runtime_behavioral",
              "hil"
            ]
          },
          "command": { "type": "string", "minLength": 1 },
          "expected_exit": { "enum": [0, 1] },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "plan_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "blocker": { "type": "string", "minLength": 1 },
          "linked_finding_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
