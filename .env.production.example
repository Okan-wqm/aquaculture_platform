# =============================================================================
# Aquaculture Platform - Production Environment Variables
# Copy this file to .env on your server and fill in the values
#
# cp .env.production.example .env
# nano .env
# =============================================================================

# --- Database ---
POSTGRES_USER=aquaculture
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=aquaculture

# --- PostgreSQL continuous backup (non-secret coordinates only) ---
# WAL-G access keys and the libsodium key are mode-0600 files under
# /var/aqua-saas/certs/wal-g/postgres, outside the PostgreSQL TLS tree;
# never place their bytes in this env file or Compose metadata.
WALG_SPACES_BUCKET=CHANGE_ME_walg_bucket
WALG_BACKUP_EPOCH=epoch-CHANGE_ME
SPACES_ENDPOINT=https://CHANGE_ME_region.digitaloceanspaces.com
SPACES_REGION=CHANGE_ME_region

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- JWT ---
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string
JWT_EXPIRES_IN=1h

# --- Encryption ---
ENCRYPTION_KEY=CHANGE_ME_32_char_hex_string
CONFIG_ENCRYPTION_KEY=CHANGE_ME_32_byte_random_value

# --- MFA & WebAuthn ---
# MFA encryption key for TOTP secret storage (AES-256-GCM)
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=CHANGE_ME_64_char_hex_string

# WebAuthn Relying Party configuration
# RP_ID must match your domain (without protocol or port)
WEBAUTHN_RP_ID=app.suderra.com
WEBAUTHN_RP_NAME=Suderra Aquaculture Platform

# --- Per-service Database Passwords (SEC-015) ---
# Used by 00-init-schemas.sh to create per-service DB roles.
# If left empty, random passwords are generated at first DB init.
# For production, set these explicitly and store them securely.
# Generate with: openssl rand -base64 32
AUTH_SERVICE_DB_PASS=
FARM_SERVICE_DB_PASS=
SENSOR_SERVICE_DB_PASS=
BILLING_SERVICE_DB_PASS=
HR_SERVICE_DB_PASS=
ALERT_SERVICE_DB_PASS=
ADMIN_SERVICE_DB_PASS=
GATEWAY_SERVICE_DB_PASS=
NOTIFICATION_SERVICE_DB_PASS=
HYDROPONICS_SERVICE_DB_PASS=
CONFIG_SERVICE_DB_PASS=
EVENT_STORE_SERVICE_DB_PASS=

# --- Service Identity ---
# Shared v2 service-identity keyring. Replace every CHANGE_ME value with a
# generated secret from your secret manager; do not reuse placeholder material.
SERVICE_IDENTITY_KEYRING={"keys":[{"kid":"platform-signing-v1","secret":"CHANGE_ME_64_CHAR_RANDOM","status":"active","callers":["gateway-api","admin-api-service","notification-service"],"audiences":["auth","auth-service","farm","farm-service","sensor","sensor-service","hr","hr-service","hydroponics","hydroponics-service","messaging","messaging-service","alert","alert-engine","billing","billing-service","notification","notification-service","config","config-service","gateway-api","observability-service"]},{"kid":"event-store-farm-v1","secret":"CHANGE_ME_64_CHAR_RANDOM","status":"active","callers":["farm-service"],"audiences":["event-store-service"],"tenantScopePolicy":"tenant-bound"},{"kid":"event-store-admin-v1","secret":"CHANGE_ME_64_CHAR_RANDOM","status":"active","callers":["admin-api-service"],"audiences":["event-store-service"],"tenantScopePolicy":"all-tenants"}]}
SERVICE_IDENTITY_SIGNING_KID=platform-signing-v1

# --- Email (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
