{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SX1302 HIL Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_kind",
    "result",
    "workflow_run_id",
    "commit_sha",
    "operator",
    "started_at",
    "completed_at",
    "hardware",
    "commands",
    "measurements",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_kind": { "const": "sx1302_hil" },
    "result": { "const": "pass" },
    "workflow_run_id": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "operator": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "minLength": 1 },
    "hardware": {
      "type": "object",
      "required": ["concentrator_model", "sx1302_hal_source_sha256", "spi_bus", "reset_gpio"],
      "additionalProperties": false,
      "properties": {
        "concentrator_model": { "type": "string", "minLength": 1 },
        "sx1302_hal_source_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "spi_bus": { "type": "string", "minLength": 1 },
        "reset_gpio": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "measurements": {
      "type": "object",
      "required": ["packets_received", "tx_acknowledged"],
      "additionalProperties": true,
      "properties": {
        "packets_received": { "type": "integer", "minimum": 1 },
        "tx_acknowledged": { "const": true },
        "frames_downlink_scheduled": { "type": "integer", "minimum": 0 },
        "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "run_duration_seconds": { "type": "integer", "minimum": 1 },
        "region": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
