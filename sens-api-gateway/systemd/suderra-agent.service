# Suderra Edge Agent — systemd unit (IEC 62443 SL-2 adversarial baseline)
#
# Generic-Linux reference unit (ADR-048 DEC-1.9, DEC-28): the v1.6.0 HC-1
# fleet's unit, from which the cloud renders the fleet unit. Every
# security-relevant directive is fixed by the `generic` profile of
# contracts/suderra-edge/v1/unit-directives.json and checked as a set, not as
# text, by tests/invariants/systemd_unit_directive_contract.rs. The Suderra OS
# unit lives in the OS image (DEC-1.8) and is checked against the same file.
#
# Hardened per ADR-018 §7 (master-key in-process defense) + ADR-020 §6 (audit
# log append-only durability) + Faz 0 item 5 of the consolidation plan
# (/root/.claude/plans/unutma-mevcut-s-stem-le-lexical-puzzle.md §5 Faz 0).
#
# Every directive below is load-bearing for one or more of:
#   FR1 (Identification & Authentication Control)
#   FR2 (Use Control)
#   FR3 (System Integrity)
#   FR4 (Data Confidentiality) — master-key-in-coredump prevention
#   FR6 (Timely Response to Events) — watchdog + audit retention
#   FR7 (Resource Availability)
#
# Install:
#   sudo useradd -r -s /usr/sbin/nologin suderra
#   sudo install -d -o suderra -g suderra -m 0750 /var/lib/suderra
#   sudo install -d -o suderra -g suderra -m 0750 /var/log/suderra
#   sudo install -m 0644 suderra-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now suderra-agent
#
# Verify hardening after install:
#   systemd-analyze security suderra-agent        # expect "exposure level: SAFE"
#   systemctl show suderra-agent -p LimitCORE     # expect LimitCORE=0
#   systemctl show suderra-agent -p SystemCallFilter

# Ordering only (DEC-6.2, DEC-7.4, DEC-11.2): safe state and local control
# never wait for the network, and a firewall or time-sync failure never stops
# the agent, so there is no Requires=, no BindsTo= and no network-online.target.
# The start limit stops a crash loop from cycling the outputs (DEC-6.5).
[Unit]
Description=Suderra edge agent
Documentation=https://github.com/Okan-wqm/aquaculture_platform/tree/main/sens-api-gateway
After=nftables.service time-sync.target
Wants=time-sync.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/suderra-agent
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300s
TimeoutStopSec=90s

# -----------------------------------------------------------------------------
# Identity — dedicated non-privileged user (FR1)
# -----------------------------------------------------------------------------
User=suderra
Group=suderra
UMask=0077

# -----------------------------------------------------------------------------
# Watchdog — systemd restarts the agent if no WATCHDOG=1 notify in 60s. The
# agent pings only while its control loops make progress (DEC-6.4). This is
# the service watchdog of systemd; the hardware watchdog (/dev/watchdog)
# belongs to PID1 alone and is never granted to the agent (DEC-6.6).
# -----------------------------------------------------------------------------
WatchdogSec=60s

# -----------------------------------------------------------------------------
# Resource limits — LimitCORE=0 blocks the master-key-in-coredump vector
# (FR4 Data Confidentiality). ADR-018 §7 requires both this AND prctl
# PR_SET_DUMPABLE=0 in-process; belt-and-braces because a compromised
# child process may have cleared the prctl flag.
# -----------------------------------------------------------------------------
LimitCORE=0
LimitNOFILE=4096
MemoryMax=256M
CPUQuota=75%
TasksMax=64

# -----------------------------------------------------------------------------
# Capabilities — none (DEC-1.8). The empty CapabilityBoundingSet= is the empty
# bounding set, and there is no AmbientCapabilities=: the agent binds nothing
# below 1024.
# -----------------------------------------------------------------------------
CapabilityBoundingSet=
NoNewPrivileges=true

# -----------------------------------------------------------------------------
# Filesystem — strict read-only root plus narrow writable paths
# /var/lib/suderra — SQLCipher offline_queue + scada state + keystore file
#                    backend + agent state (activation, policy floors)
# /var/log/suderra — append-only audit log (ADR-020 HMAC chain sink)
# /etc/suderra    — READ-ONLY for the agent. Config is operator-owned and
#                   factory-signed (D-13). Configuration changes go through
#                   a separate operator flow, not through agent writes.
# -----------------------------------------------------------------------------
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/suderra
ReadWritePaths=/var/lib/suderra /var/log/suderra

# -----------------------------------------------------------------------------
# Kernel surface reduction (FR3)
# -----------------------------------------------------------------------------
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
# ProtectClock=true denies clock_settime/adjtime; edge agent NEVER sets the
# wall clock — chrony runs as a separate service. Prevents a compromised
# agent from fabricating audit timestamps (FR6).
ProtectClock=true
# ProtectProc=invisible hides other processes from /proc; ProcSubset=pid
# further limits /proc to the agent's own entries.
ProtectProc=invisible
ProcSubset=pid

# -----------------------------------------------------------------------------
# IPC + namespace + realtime restrictions (FR2, FR3)
# -----------------------------------------------------------------------------
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
RemoveIPC=true

# -----------------------------------------------------------------------------
# Executable memory protection — W^X. Rust does not JIT at runtime; any mmap
# requesting PROT_EXEC beyond the loader is a strong compromise signal.
# -----------------------------------------------------------------------------
MemoryDenyWriteExecute=true

# -----------------------------------------------------------------------------
# Syscall filter — @system-service is the tokio-compatible superset that
# excludes @clock, @debug, @module, @mount, @obsolete, @privileged, @raw-io,
# @reboot, @swap, @cpu-emulation. Combined with CapabilityBoundingSet this
# collapses the kernel attack surface to the minimum needed to serve
# Modbus/MQTT/GPIO/I2C workloads.
# -----------------------------------------------------------------------------
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @module @raw-io @reboot @swap @privileged
SystemCallErrorNumber=EPERM

# -----------------------------------------------------------------------------
# Device access — default-deny + explicit allowlist. Each entry is justified:
#   /dev/gpiomem   RPi GPIO memory-mapped page (per-line GPIO control)
#   /dev/i2c-1     I2C bus 1 (Atlas EZO sensors, MAX31865 RTD config mux)
#   /dev/spidev0.0 SPI chip select 0 (MAX31865 RTD amplifier, MFRC522 removed)
#   /dev/spidev0.1 SPI chip select 1 (reserved for dual-sensor topology)
#   /dev/ttyAMA0   PL011 UART for Modbus-RTU on RPi
#   /dev/ttyUSB0   USB-serial adapter for Modbus-RTU (FTDI/Prolific)
#   char-rtc       RTC (CLOCK_BOOTTIME reference; no settime granted)
# /dev/{null,zero,random,urandom} auto-allowed by systemd's default minimal set.
# Never granted: /dev/watchdog (PID1 owns the hardware watchdog, DEC-6.6) and
# /dev/tpm0 or /dev/tpmrm0 (no TPM device in contract 1.x: a compromised agent
# could clear an unowned TPM or trip its lockout, DEC-21).
# -----------------------------------------------------------------------------
DevicePolicy=closed
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/spidev0.1 rw
DeviceAllow=/dev/ttyAMA0 rw
DeviceAllow=/dev/ttyUSB0 rw
DeviceAllow=char-rtc r

# -----------------------------------------------------------------------------
# Network egress — AF_INET/INET6/UNIX/NETLINK only (see RestrictAddressFamilies).
# IPAddressDeny + IPAddressAllow CIDR allowlist is deliberately NOT enforced
# here — the set depends on per-deployment MQTT broker + provisioning API
# endpoints. Enforcement is via nftables in the deployment runbook
# (docs/runbooks/edge-network-egress.md, Faz 10) rather than the unit file
# because systemd unit files should not hardcode deployment CIDRs.
# -----------------------------------------------------------------------------
# (No IPAddressDeny here — see runbook.)

# -----------------------------------------------------------------------------
# Logging — structured JSON via journald; no stdin; no tty
# -----------------------------------------------------------------------------
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=suderra-agent
SyslogLevelPrefix=true

[Install]
WantedBy=multi-user.target
