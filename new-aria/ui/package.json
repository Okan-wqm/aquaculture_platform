{
  "name": "new-aria-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "new-aria operator console: a Node service that projects ARIA's ledgers over HTTP/SSE plus a React SPA. Lives entirely inside new-aria/.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test 'server/test/**/*.test.ts'",
    "test:web": "vitest run --config web/vite.config.ts",
    "dev:server": "node --watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "principals": "node server/src/principals-cli.ts",
    "start": "node server/dist/server/src/index.js"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "24.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "3.2.7"
  }
}
