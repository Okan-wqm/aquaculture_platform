# Dist-only AquaMobil image — freshly built local dist copied in.
FROM nginx:1.27.3-alpine AS production
RUN rm /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/nginx/aquamobil.conf /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/nginx/snippets/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY web/apps/aquamobil/dist /usr/share/nginx/html
RUN mkdir -p /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp /var/cache/nginx/fastcgi_temp /var/cache/nginx/uwsgi_temp /var/cache/nginx/scgi_temp && \
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
