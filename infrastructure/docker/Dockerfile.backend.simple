# syntax=docker/dockerfile:1.4
# =============================================================================
# Aquaculture Platform - Backend Services Dockerfile (Simplified)
# Uses pre-built artifacts from host - MUCH FASTER
# Build services on host first: npx nx build <service-name>
#
# Optimizations:
# - BuildKit cache mount for npm
# - Use with: DOCKER_BUILDKIT=1 docker build ...
# =============================================================================

# M-06: Pin base image to exact version for reproducible builds and to prevent
# silent security regressions from upstream tag mutations.
#
# WHY Debian slim instead of Alpine: dl-cdn.alpinelinux.org (Fastly CDN) intermittently
# blocks GitHub Actions runner IPs, causing `apk add` to fail with "Permission denied"
# even though the base image pull succeeds. apt-get from Debian mirrors does not exhibit
# this behavior from GitHub-hosted runners. Both curl and dumb-init are in the Debian
# package repository. Image size delta is acceptable (~80 MB vs ~50 MB compressed).
FROM node:22.13.1-bookworm-slim AS base

# Install curl for health checks and dumb-init for proper PID-1 signal handling.
# --no-install-recommends keeps the layer minimal; apt cache is purged immediately.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl dumb-init && \
    rm -rf /var/lib/apt/lists/*

# Security: Run as non-root user
RUN groupadd --gid 1001 nodejs && \
    useradd --uid 1001 --gid nodejs --no-create-home --shell /bin/sh nestjs

WORKDIR /app

# GitHub-hosted runners occasionally see npm registry connection resets during
# parallel image builds. Keep npm's retry envelope explicit inside the image
# build so transient ECONNRESETs do not fail a deploy run on the first aborted
# response body.
ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    NPM_CONFIG_FETCH_TIMEOUT=300000 \
    NPM_CONFIG_FUND=false

# Build argument for service name
ARG SERVICE_NAME

# Copy package files for production dependency installation
COPY package*.json ./
# npm installs repository-local file dependencies as symlinks. Copy the
# fail-closed Apollo package before npm ci so the local link stays valid both
# while the image is built and when the non-root service starts.
COPY --chown=nestjs:nodejs tools/vendor/apollo-playground-disabled ./tools/vendor/apollo-playground-disabled

# Install ONLY production dependencies.
# 2026-04-30: Docker images must use the same strict peer-dependency policy as CI.
# WHY: --legacy-peer-deps can hide Apollo/TypeORM peer graph conflicts that CI and
# production must see before an image is published.
RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    npm ci --omit=dev --ignore-scripts --no-audit && \
    npm ls --omit=dev --all >/dev/null && \
    node -e "require('@apollo/server-plugin-landing-page-graphql-playground')" && \
    chown -R nestjs:nodejs /app/node_modules

# Copy the pre-built service from host's dist folder
COPY --chown=nestjs:nodejs dist/apps/${SERVICE_NAME} ./dist

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# IMPORTANT: No HEALTHCHECK directive here — health checks are defined in
# docker-compose.yml / Kubernetes manifests (runtime configuration).
# Baking HEALTHCHECK into the image causes conflicts when compose tries to
# override it: Docker uses the image-embedded check as fallback, and some
# compose v2 versions don't properly override the test command.

# Switch to non-root user
USER nestjs

# Expose port
EXPOSE 3000

# Use dumb-init to handle signals properly for graceful shutdown
ENTRYPOINT ["dumb-init", "--"]

# Start the service
CMD ["node", "dist/main.js"]
