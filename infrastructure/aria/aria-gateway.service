# Plan 032 Faz 032f — ARIA event gateway daemon (webhooks + scheduler).
# Binds 127.0.0.1:8787; nginx fronts it at https://app.suderra.com/aria/webhook/.
# Secrets come from /etc/aria/aria.env by NAME:
#   ARIA_GITHUB_WEBHOOK_SECRET  ARIA_ALERTMANAGER_BEARER  ARIA_OPERATOR_BEARER
#   ARIA_GATEWAY_ACTOR_ALLOWLIST (comma-separated GitHub logins)  GH_TOKEN (workflow dispatch)
# Install:
#   cp infrastructure/aria/aria-gateway.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now aria-gateway.service
# Stop cleanly: touch /var/aqua-saas/aria-tools/ARIA_STOP  (or systemctl stop → SIGTERM)
# CODE ROOT (2026-09-04): /var/lib/aria/code, a deploy-independent worktree.
# It used to be /var/aqua-saas — a bare repo (core.bare=true) whose file tree
# predates Plan 032f and has no gateway package, so ExecStart died with
# `invalid choice: 'gateway'` and crash-looped against Restart=on-failure.
# The deploy checkout is deliberately NOT used: deploy-paths.sh force-detaches
# it on every deploy and removes it when unhealthy.
# Refresh with: git -C /var/lib/aria/code fetch origin main && git -C /var/lib/aria/code checkout --detach origin/main
[Unit]
Description=ARIA event gateway (webhook ingress + closed-vocabulary scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gharunner
Group=gharunner
WorkingDirectory=/var/lib/aria/code
EnvironmentFile=-/etc/aria/aria.env
Environment=PYTHONPATH=/var/lib/aria/code/aria-kernel
Environment=ARIA_TOOLS_DIR=/var/aqua-saas/aria-tools
# WORKSPACE BASE: the kernel defaults to $HOME/.aria/workspaces, which
# ProtectHome=read-only correctly refuses. StateDirectory makes systemd create
# /var/lib/aria-runtime owned by this unit's user and add it to ReadWritePaths,
# so the hardening stays and no directory has to be hand-chowned.
StateDirectory=aria-runtime
Environment=ARIA_WORKSPACE_BASE=/var/lib/aria-runtime/workspaces
ExecStart=/usr/bin/python3 -m aria_kernel gateway serve --workspace-root /var/lib/aria/code --tools-dir /var/aqua-saas/aria-tools --host 127.0.0.1 --port 8787 --poll-interval-seconds 60
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/aqua-saas/aria-tools
MemoryMax=512M

[Install]
WantedBy=multi-user.target
