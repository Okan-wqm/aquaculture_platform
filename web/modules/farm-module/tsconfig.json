{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@aquaculture/shared-ui": ["../../shared-ui/src"],
      "@aquaculture/shared-contracts": ["../../../libs/shared-contracts/src/index.ts"],
      "@aquaculture/feeding-contracts": ["../../../libs/feeding-contracts/src/index.ts"],
      "@platform/shared-ui/*": ["../../shared-ui/src/*"],
      "@aquaculture/farm-shared": ["../../../libs/farm-shared/src"],
      "@platform/aquaculture-engines": ["../../../libs/aquaculture-engines/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
