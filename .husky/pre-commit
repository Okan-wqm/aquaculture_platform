#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Pre-commit gates — Phase 2 of
# docs/plans/2026-04-17-agentic-post-audit-consolidation-plan.md.
#
# Each gate fails the commit independently. Gates in staged-only mode
# are no-ops on non-matching commits.
#
# WHY ./node_modules/.bin/ts-node (not `npx ts-node`):
#   ORPHAN-012 root cause was npx resolving whatever the local npm
#   cache exposed — TS 5.x or TS 6.x or TS 7.x at random — producing
#   a TS5103 / TS5107 trip in the gates depending on which compiler
#   landed first. The local binary path forces resolution through
#   the workspace's `node_modules`, which `npm ci` populates from the
#   committed `package-lock.json`. Combined with the exact pin in
#   `package.json` and the assertion in `tools/gates/check-pin.ts`,
#   the gate suite cannot run against a drifted compiler — Tier-1
#   "make it impossible" per CLAUDE.md.

GATE_TS_NODE="./node_modules/.bin/ts-node"
GATE_TSCONFIG="--project tools/gates/tsconfig.json"

# Step 0 — verify pinned dep versions BEFORE running any other gate.
# A version drift here means subsequent gate output is suspect; fail
# fast so the developer sees the root cause, not a confusing TS5103.
"$GATE_TS_NODE" --transpile-only tools/gates/check-pin.ts || exit 1

"$GATE_TS_NODE" $GATE_TSCONFIG tools/gates/banned-phrase.ts --mode=staged || exit 1
"$GATE_TS_NODE" $GATE_TSCONFIG tools/gates/banned-construct.ts --mode=staged || exit 1
"$GATE_TS_NODE" $GATE_TSCONFIG tools/gates/migration-sql-lint.ts --mode=staged || exit 1
"$GATE_TS_NODE" $GATE_TSCONFIG tools/gates/tier-claim-lint.ts --mode=staged || exit 1

# Step N — run unit tests for tools/gates pure helpers
# (Batch #351 — wires Batches #348/#349/#350 spec files
# into the pre-commit gate so the helper tests fire on
# every commit, not just when invoked manually).
#
# Glob-based discovery: any `tools/gates/*.spec.ts` file
# automatically joins the gate. The `[ -f "$spec" ]`
# guard handles the no-match case (POSIX sh passes the
# literal pattern when no files match; without the
# check, ts-node would error on a non-existent file).
#
# Tests run via node:test; ~160ms total for the current
# 39-test suite (16 clippy-affected + 23 commit-msg-
# validator). Fast enough for per-commit ergonomics.
# Glob `tools/*gates/*.spec.ts` covers BOTH tools/gates/ (the original
# pre-commit gates) AND tools/lint-gates/ (the A2 ESLint gate-preservation
# baseline). The ESLint-API specs add ~2-3s; acceptable for the safety they
# give the ESLint 8->9 flat-config migration.
for spec in tools/*gates/*.spec.ts; do
  [ -f "$spec" ] || continue
  "$GATE_TS_NODE" $GATE_TSCONFIG "$spec" || exit 1
done

# format-scope manifesti — yeni/silinen izlenen dosya ya da üretilmiş-dosya
# içerik hash'i değişimi manifesti bayatlatır; CI'daki banned-phrase-gate'in
# SON adımı (npm run quality:format-scope:check) aynı kontrolü koşar. Push
# sonrası CI kırmızısı yerine commit anında yakala (tier-3 make-it-detectable;
# 137b4a46 ile dfb57127 bu sınıfın iki canlı örneğiydi).
node tools/quality/quality.mjs format-scope check || {
  echo "format-scope bayat: 'npm run quality:format-scope:generate' koşup manifesti bu commit'e ekleyin." >&2
  exit 1
}

# Prettier sapması — yukarıdaki format-scope gate'i manifestin TAZELİĞİNİ
# doğrular, biçimin kendisini DEĞİL. CI (`ci-full.yml`, lint-and-typecheck
# adım 10) iki format kapısı koşar; bu hook uzun süre yalnızca ilkini
# aynaladı, dolayısıyla `format check-changed` sapmayı push sonrasında CI'da
# yakaladı. ORPHAN-HIGH-500: bu dalda 8 commit yeşil hook'la sapma taşıdı.
# Staged mod, HEAD^ yerine indeksi HEAD'e karşı yargılar — commit anında
# doğru karşılaştırma budur (tier-3 make-it-detectable).
node tools/quality/quality.mjs format check-staged || exit 1
