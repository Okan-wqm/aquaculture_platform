{
  "name": "sensor-ingestion",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/sensor-ingestion/src",
  "tags": ["scope:rust", "type:service", "layer:ingestion"],
  "targets": {
    "build": {
      "executor": "@aqua/cargo:run",
      "options": {
        "command": "build",
        "package": "sensor-ingestion",
        "release": false
      },
      "outputs": ["{workspaceRoot}/target/debug/sensor-ingestion"],
      "cache": true
    },
    "build-release": {
      "executor": "@aqua/cargo:run",
      "options": {
        "command": "build",
        "package": "sensor-ingestion",
        "release": true
      },
      "outputs": ["{workspaceRoot}/target/release/sensor-ingestion"],
      "cache": true
    },
    "test": {
      "executor": "@aqua/cargo:run",
      "options": {
        "command": "test",
        "package": "sensor-ingestion",
        "allFeatures": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@aqua/cargo:run",
      "options": {
        "command": "clippy",
        "package": "sensor-ingestion",
        "args": ["--all-targets", "--all-features", "--", "-D", "warnings"]
      },
      "cache": true
    },
    "fmt-check": {
      "executor": "@aqua/cargo:run",
      "options": {
        "command": "fmt",
        "package": "sensor-ingestion",
        "args": ["--", "--check"]
      },
      "cache": true
    }
  }
}
