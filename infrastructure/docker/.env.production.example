# =============================================================================
# Aquaculture Platform - Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env file to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB)
# -----------------------------------------------------------------------------
POSTGRES_USER=aquaculture
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=aquaculture

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production

# -----------------------------------------------------------------------------
# Email (Optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
DOMAIN=YOUR_SERVER_IP
# Or if you have a domain:
# DOMAIN=app.yourdomain.com
# MOBILE_DOMAIN=m.yourdomain.com

# -----------------------------------------------------------------------------
# SSL/TLS (Optional - for HTTPS)
# -----------------------------------------------------------------------------
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# -----------------------------------------------------------------------------
# GitHub Container Registry (for pulling images)
# -----------------------------------------------------------------------------
# Use a GitHub Actions secret or a fine-grained PAT with read:packages scope only.
# Do NOT store a PAT directly in this file or in .env — use GitHub Actions secrets
# (Settings > Secrets and Variables > Actions) or a short-lived deploy token.
# GHCR_TOKEN is used only by the CI pipeline to pull images on the droplet.
# Example rotation: gh auth token -- or -- docker login ghcr.io -u USERNAME --password-stdin
GHCR_TOKEN=REPLACE_WITH_READONLY_PACKAGE_TOKEN

# -----------------------------------------------------------------------------
# Object Storage (MinIO)
# -----------------------------------------------------------------------------
# REQUIRED — MinIO will refuse to start if these are not set.
# Generate strong credentials: openssl rand -base64 24
MINIO_USER=CHANGE_ME_MINIO_USER
MINIO_PASSWORD=CHANGE_ME_MINIO_PASSWORD_MIN_8_CHARS

# -----------------------------------------------------------------------------
# Encryption Key (farm-service field-level encryption)
# -----------------------------------------------------------------------------
# REQUIRED — farm-service will refuse to start if this is not set.
# Generate a 32-byte key: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_base64_32

# Dedicated config-service encryption key for company-owned provider secrets.
# Generate independently from ENCRYPTION_KEY: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_base64_32

# Signed internal farm-service -> config-service credential RPC.
# Generate a unique random secret and keep the same keyring on both services.
SERVICE_IDENTITY_KEYRING={"keys":[{"kid":"platform-signing-v1","secret":"CHANGE_ME_64_CHAR_RANDOM","status":"active"}]}
SERVICE_IDENTITY_SIGNING_KID=platform-signing-v1

# -----------------------------------------------------------------------------
# Farm environmental monitoring (SEA_CAGE only)
# -----------------------------------------------------------------------------
# Keep disabled until the company-level CDSE credential and the MET Norway
# application identity below have been provisioned.
FARM_ENVIRONMENT_MONITORING_ENABLED=false
# Required during the one-shot legacy credential cutover. It must be the
# dedicated key that encrypted existing sentinel_hub_settings rows.
SENTINEL_HUB_ENCRYPTION_KEY=CHANGE_ME_EXISTING_SENTINEL_KEY
MET_NORWAY_APPLICATION_NAME=AquaSaaS/1.0
MET_NORWAY_CONTACT=CHANGE_ME_OPERATIONAL_EMAIL_OR_HTTPS_URL
# Optional: without this ID only Frost station history is unavailable.
MET_NORWAY_FROST_CLIENT_ID=

# -----------------------------------------------------------------------------
# MFA & WebAuthn (auth-service)
# -----------------------------------------------------------------------------
# REQUIRED — auth-service will crash on startup in production without this.
# Encrypts TOTP secrets at rest with AES-256-GCM.
# Generate a 64-character hex key: openssl rand -hex 32
MFA_ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_hex_32

# WebAuthn Relying Party configuration
# RP_ID must match your domain exactly (no protocol, no port)
WEBAUTHN_RP_ID=app.suderra.com
WEBAUTHN_RP_NAME=Suderra Aquaculture Platform

# -----------------------------------------------------------------------------
# Per-service Database Passwords (SEC-015)
# -----------------------------------------------------------------------------
# Used by 00-init-schemas.sh to create per-service DB roles.
# If left empty, random passwords are generated at first DB init.
# For production, set these explicitly and store them securely.
# Generate with: openssl rand -base64 32
AUTH_SERVICE_DB_PASS=
FARM_SERVICE_DB_PASS=
SENSOR_SERVICE_DB_PASS=
BILLING_SERVICE_DB_PASS=
HR_SERVICE_DB_PASS=
ALERT_SERVICE_DB_PASS=
ADMIN_SERVICE_DB_PASS=
GATEWAY_SERVICE_DB_PASS=
NOTIFICATION_SERVICE_DB_PASS=
HYDROPONICS_SERVICE_DB_PASS=
CONFIG_SERVICE_DB_PASS=
