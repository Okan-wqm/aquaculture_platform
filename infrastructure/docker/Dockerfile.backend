# syntax=docker/dockerfile:1.4
# =============================================================================
# Aquaculture Platform - Backend Services Dockerfile
# Multi-stage build for NestJS microservices
# 
# Optimizations:
# - BuildKit cache mounts for npm and NX cache
# - Use with: DOCKER_BUILDKIT=1 docker build ...
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Base image with dependencies
# -----------------------------------------------------------------------------
FROM node:22-alpine AS base

# Install build dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./

# -----------------------------------------------------------------------------
# Stage 2: Dependencies installation
# -----------------------------------------------------------------------------
FROM base AS deps

# Install all dependencies (including devDependencies for build)
# Skip prepare script (husky) in Docker
# Use npm ci with BuildKit cache mount for faster subsequent builds
RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    npm ci --legacy-peer-deps --ignore-scripts --no-audit

# -----------------------------------------------------------------------------
# Stage 3: Builder - Compile TypeScript
# -----------------------------------------------------------------------------
FROM deps AS builder

# Copy source code
# ARCH-015: Copying full monorepo source here. To reduce cache invalidation,
# use a .dockerignore that excludes other apps, or pass SERVICE_NAME earlier
# and copy only apps/${SERVICE_NAME} and its lib dependencies.
COPY apps/ ./apps/
COPY libs/ ./libs/
COPY platform/ ./platform/

# Build argument for service name
ARG SERVICE_NAME

# Build the specific service using NX
# Increase Node memory limit for large builds (sensor-service has 1.4MB bundle)
# Use NX cache mount for incremental builds
# Disable NX Cloud in Docker to prevent connection timeouts that hang builds
ENV NODE_OPTIONS="--max-old-space-size=2048"
ENV NX_NO_CLOUD=true
ENV NX_CLOUD_ACCESS_TOKEN=""
ENV NX_DAEMON=false
RUN --mount=type=cache,target=/app/.nx/cache,sharing=shared \
    npx nx build ${SERVICE_NAME}

# -----------------------------------------------------------------------------
# Stage 4: Production dependencies only
# -----------------------------------------------------------------------------
FROM base AS prod-deps

# Skip prepare script (husky) in Docker
# Production dependencies only with BuildKit cache mount
RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    npm ci --legacy-peer-deps --omit=dev --ignore-scripts --no-audit

# -----------------------------------------------------------------------------
# Stage 5: Production image
# -----------------------------------------------------------------------------
FROM node:22-alpine AS production

# Install curl for health checks and other utilities
RUN apk add --no-cache curl dumb-init

# Security: Run as non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001

WORKDIR /app

# Copy production dependencies with correct ownership (ARCH-001)
COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules

# Copy built application
ARG SERVICE_NAME
COPY --from=builder --chown=nestjs:nodejs /app/dist/apps/${SERVICE_NAME} ./dist

# Copy package.json for version info
COPY --chown=nestjs:nodejs package.json ./

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Health check - uses /health/live endpoint for liveness probe
# Increased start-period for NestJS bootstrap time
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:${PORT}/health/live || exit 1

# Switch to non-root user
USER nestjs

# Expose port
EXPOSE 3000

# Use dumb-init to handle signals properly for graceful shutdown
ENTRYPOINT ["dumb-init", "--"]

# Start the service
CMD ["node", "dist/main.js"]
