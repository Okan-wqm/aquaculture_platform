{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "dom"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/out-tsc",
    "rootDir": ".",
    "removeComments": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "baseUrl": ".",
    "paths": {
      "@platform/shared": ["libs/shared/src/index.ts"],
      "@platform/shared-ui": ["web/shared-ui/src/index.ts"],
      "@platform/shared-ui/*": ["web/shared-ui/src/*"],
      "@aquaculture/shared-ui": ["web/shared-ui/src/index.ts"],
      "@aquaculture/shared-ui/*": ["web/shared-ui/src/*"],
      "@aquaculture/shared-contracts": ["libs/shared-contracts/src/index.ts"],
      "@aquaculture/shared-contracts/*": ["libs/shared-contracts/src/*"],
      "@platform/backend-common": ["libs/backend-common/src/index.ts"],
      "@aquaculture/backend-common": ["libs/backend-common/src/index.ts"],
      "@aquaculture/backend-common/auth": ["libs/backend-common/src/auth/index.ts"],
      "@aquaculture/backend-common/audit": ["libs/backend-common/src/audit/index.ts"],
      "@aquaculture/backend-common/billing": ["libs/backend-common/src/billing/index.ts"],
      "@aquaculture/backend-common/ai-safety": ["libs/backend-common/src/ai-safety/index.ts"],
      "@aquaculture/backend-common/bootstrap": ["libs/backend-common/src/bootstrap/index.ts"],
      "@aquaculture/backend-common/config": ["libs/backend-common/src/config/index.ts"],
      "@aquaculture/backend-common/config-client": [
        "libs/backend-common/src/config-client/index.ts"
      ],
      "@aquaculture/backend-common/constants": ["libs/backend-common/src/constants/index.ts"],
      "@aquaculture/backend-common/context": ["libs/backend-common/src/context/index.ts"],
      "@aquaculture/backend-common/database": ["libs/backend-common/src/database/index.ts"],
      "@aquaculture/backend-common/database/drift-inspection": [
        "libs/backend-common/src/database/drift-inspection.ts"
      ],
      "@aquaculture/backend-common/database/mutation-instant-authority": [
        "libs/backend-common/src/database/mutation-instant-authority.ts"
      ],
      "@aquaculture/backend-common/dataloader": ["libs/backend-common/src/dataloader/index.ts"],
      "@aquaculture/backend-common/decorators": ["libs/backend-common/src/decorators/index.ts"],
      "@aquaculture/backend-common/events": ["libs/backend-common/src/events/index.ts"],
      "@aquaculture/backend-common/filters": ["libs/backend-common/src/filters/index.ts"],
      "@aquaculture/backend-common/finding-registry": [
        "libs/backend-common/src/finding-registry/index.ts"
      ],
      "@aquaculture/backend-common/gdpr": ["libs/backend-common/src/security/gdpr/index.ts"],
      "@aquaculture/backend-common/graphql": ["libs/backend-common/src/graphql/index.ts"],
      "@aquaculture/backend-common/guards": ["libs/backend-common/src/guards/index.ts"],
      "@aquaculture/backend-common/health": ["libs/backend-common/src/health/index.ts"],
      "@aquaculture/backend-common/http": ["libs/backend-common/src/http/index.ts"],
      "@aquaculture/backend-common/logging": ["libs/backend-common/src/logging/index.ts"],
      "@aquaculture/backend-common/metrics": ["libs/backend-common/src/metrics/index.ts"],
