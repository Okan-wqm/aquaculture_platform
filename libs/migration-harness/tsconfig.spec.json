{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["jest", "node"],
    // isolatedModules is now in tsconfig.base.json (PR-41,
    // PROC-MEDIUM-011 phase 1) — no per-project override needed
    // anymore; type-only re-exports across the monorepo were
    // converted to `export type`. The PR-32 override is removed.
    //
    // noPropertyAccessFromIndexSignature stays disabled at the
    // spec layer because the cross-lib spec compile traverses
    // production sources of libs/backend-common, libs/event-
    // contracts, platform/libs/event-bus — those still use
    // `process.env.X` style access. Tightening THAT setting
    // monorepo-wide is the PROC-MEDIUM-011 phase 2 work-stream.
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
