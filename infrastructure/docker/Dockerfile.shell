# =============================================================================
# Aquaculture Platform - Shell Application Dockerfile
# Host application for Module Federation
# Uses pre-built dist folder for faster builds
# =============================================================================

# SECURITY: Pin nginx by digest for immutable, reproducible builds.
FROM nginx:1.27.3-alpine@sha256:a5127daff3d6f4a3c3f7d2cfb7832aee2127d99b6e21d2b1e0d2d3e1a0a7c8b0 AS production

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx configuration for SPA with Module Federation
COPY infrastructure/docker/nginx/shell.conf /etc/nginx/conf.d/default.conf

# Copy pre-built shell application
COPY web/shell/dist /usr/share/nginx/html

# Environment variables for runtime config (defaults; overridden by compose)
ENV DASHBOARD_URL=http://dashboard:80
ENV FARM_MODULE_URL=http://farm-module:80
ENV PROCESS_EDITOR_URL=http://process-editor:80
ENV ADMIN_PANEL_URL=http://admin-panel:80
ENV HR_MODULE_URL=http://hr-module:80
ENV SENSOR_MODULE_URL=http://sensor-module:80
ENV HYDROPONICS_MODULE_URL=http://hydroponics-module:80
ENV TENANT_ADMIN_URL=http://tenant-admin:80

# ARCH-011: Copy the runtime config script from repository (readable, testable,
# avoids fragile echo-chain RUN and shell-quoting pitfalls).
COPY infrastructure/docker/scripts/40-create-runtime-config.sh /docker-entrypoint.d/40-create-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-create-runtime-config.sh

# D17-DF-001: Run as non-root (aligned with Dockerfile.frontend pattern)
# Pre-create nginx temp directories (nginx needs these at startup)
RUN mkdir -p /var/cache/nginx/client_temp \
             /var/cache/nginx/proxy_temp \
             /var/cache/nginx/fastcgi_temp \
             /var/cache/nginx/uwsgi_temp \
             /var/cache/nginx/scgi_temp && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid && \
    chown -R nginx:nginx /docker-entrypoint.d

USER nginx

# Health check - use 127.0.0.1 to avoid IPv6 issues
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
