{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/messaging-service",
    "rootDir": "../..",
    "module": "commonjs",
    "target": "ES2021",
    "types": [
      "node"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true
  },
  "include": [
    "src/**/*.ts",
    "../../libs/backend-common/src/**/*.ts",
    "../../libs/event-contracts/src/**/*.ts",
    "../../libs/shared/src/**/*.ts",
    "../../platform/libs/event-bus/src/**/*.ts",
    "../../platform/libs/cqrs/src/**/*.ts",
    "../../platform/libs/domain/src/**/*.ts",
    "../../platform/libs/shared-dtos/src/**/*.ts",
    "../../platform/libs/validation/src/**/*.ts",
    "../../platform/libs/telemetry/src/**/*.ts",
    "../../platform/libs/observability/src/**/*.ts",
    "../../platform/libs/security/src/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts",
    "jest.config.ts",
    "../../libs/testing/**",
    "../../libs/backend-common/src/**/*.spec.ts",
    "../../libs/backend-common/src/**/*.test.ts",
    "../../libs/backend-common/src/**/__tests__/**",
    "../../libs/event-contracts/src/**/*.spec.ts",
    "../../libs/event-contracts/src/**/*.test.ts",
    "../../libs/shared/src/**/*.spec.ts",
    "../../libs/shared/src/**/*.test.ts",
    "../../platform/libs/event-bus/src/**/*.spec.ts",
    "../../platform/libs/event-bus/src/**/*.test.ts",
    "../../platform/libs/event-bus/src/**/__tests__/**",
    "../../platform/libs/cqrs/src/**/*.spec.ts",
    "../../platform/libs/cqrs/src/**/*.test.ts",
    "../../platform/libs/domain/src/**/*.spec.ts",
    "../../platform/libs/domain/src/**/*.test.ts",
    "../../platform/libs/shared-dtos/src/**/*.spec.ts",
    "../../platform/libs/shared-dtos/src/**/*.test.ts",
    "../../platform/libs/validation/src/**/*.spec.ts",
    "../../platform/libs/validation/src/**/*.test.ts",
    "../../platform/libs/telemetry/src/**/*.spec.ts",
    "../../platform/libs/telemetry/src/**/*.test.ts",
    "../../platform/libs/observability/src/**/*.spec.ts",
    "../../platform/libs/observability/src/**/*.test.ts",
    "../../platform/libs/security/src/**/*.spec.ts",
    "../../platform/libs/security/src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/test-utils/**",
    "src/**/test-helpers/**",
    "src/**/*.e2e-spec.ts"
  ]
}
