{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "dom"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/out-tsc",
    "rootDir": ".",
    "removeComments": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "baseUrl": ".",
    "paths": {
      "@platform/shared": ["libs/shared/src/index.ts"],
      "@platform/shared-ui": ["web/shared-ui/src/index.ts"],
      "@platform/shared-ui/*": ["web/shared-ui/src/*"],
      "@platform/backend-common": ["libs/backend-common/src/index.ts"],
      "@aquaculture/backend-common": ["libs/backend-common/src/index.ts"],
      "@aquaculture/backend-common/audit": ["libs/backend-common/src/audit/index.ts"],
      "@aquaculture/backend-common/gdpr": ["libs/backend-common/src/security/gdpr/index.ts"],
      "@aquaculture/backend-common/finding-registry": ["libs/backend-common/src/finding-registry/index.ts"],
      "@platform/event-contracts": ["libs/event-contracts/src/index.ts"],
      "@platform/storage": ["libs/storage/src/index.ts"],
      "@platform/sdk": ["libs/sdk/typescript/src/index.ts"],
      "@platform/testing": ["libs/testing/src/index.ts"],
      "@platform/event-bus": ["platform/libs/event-bus/src/index.ts"],
      "@platform/outbox": ["platform/libs/outbox/src/index.ts"],
      "@platform/cqrs": ["platform/libs/cqrs/src/index.ts"],
      "@web/shared-ui": ["web/shared-ui/src/index.ts"],
      "@aquaculture/node-components": ["libs/node-components/src/index.ts"],
      "@platform/aquaculture-engines": ["libs/aquaculture-engines/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", ".nx"]
}