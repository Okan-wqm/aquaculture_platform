{
  "name": "@platform/mcp-farm-management",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "mcp/farm-management/src",
  "projectType": "application",
  "tags": ["scope:mcp", "type:service"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "mcp/farm-management/src/**/*.ts",
          "mcp/farm-management/vitest.config.ts"
        ]
      }
    },
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": {
        "script": "typecheck"
      }
    }
  }
}
