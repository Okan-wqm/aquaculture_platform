{
  "mcpServers": {
    "aria": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "aria_kernel",
        "mcp",
        "serve",
        "--workspace-root",
        ".",
        "--tools-dir",
        "aria-tools"
      ],
      "env": {
        "PYTHONPATH": "aria-kernel"
      }
    }
  }
}
