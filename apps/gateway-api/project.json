{
  "name": "gateway-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gateway-api/src",
  "projectType": "application",
  "tags": [
    "scope:backend",
    "type:gateway"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/gateway-api"
      ],
      "defaultConfiguration": "production",
      "options": {
        "command": "bash tools/build/build-service.sh gateway-api"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "gateway-api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "gateway-api:build:development"
        },
        "production": {
          "buildTarget": "gateway-api:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/gateway-api/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/gateway-api/jest.config.ts"
      }
    }
  }
}
