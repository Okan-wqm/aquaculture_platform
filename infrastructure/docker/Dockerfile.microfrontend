# Generic Dockerfile for microfrontend modules
# Usage: docker build -f Dockerfile.microfrontend --build-arg MODULE_PATH=web/modules/dashboard -t dashboard .

ARG MODULE_PATH

# M-06: Pin nginx to exact version for reproducible builds and security
FROM nginx:1.27.3-alpine AS production

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx config
COPY infrastructure/docker/nginx/microfrontend.conf /etc/nginx/conf.d/default.conf

# Copy pre-built dist folder
ARG MODULE_PATH
COPY ${MODULE_PATH}/dist /usr/share/nginx/html

# D17-DF-001: Run as non-root (aligned with Dockerfile.frontend pattern)
# Pre-create nginx temp directories (nginx needs these at startup)
RUN mkdir -p /var/cache/nginx/client_temp \
             /var/cache/nginx/proxy_temp \
             /var/cache/nginx/fastcgi_temp \
             /var/cache/nginx/uwsgi_temp \
             /var/cache/nginx/scgi_temp && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/remoteEntry.js || exit 1

CMD ["nginx", "-g", "daemon off;"]
