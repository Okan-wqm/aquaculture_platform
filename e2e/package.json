{
  "name": "@aquaculture/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test infrastructure for Aquaculture SaaS Platform",
  "scripts": {
    "test": "playwright test",
    "test:security": "playwright test --project=security",
    "test:workflow": "playwright test --project=workflow",
    "test:integration": "playwright test --project=integration",
    "test:invariants": "jest --config jest.config.ts --testPathPattern='-invariants\\.spec\\.ts$'",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "ajv": "^8.12.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
