{
  "name": "aria-adapters",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/aria-adapters",
  "projectType": "library",
  "tags": ["scope:tools", "type:aria"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js tools/aria-adapters --ext .ts --max-warnings=0"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/**/*.rs",
        "{workspaceRoot}/**/Cargo.toml",
        "{workspaceRoot}/**/UPSTREAM-MANIFEST.sha256",
        "{workspaceRoot}/tools/gates/**/*.ts",
        "{workspaceRoot}/infrastructure/**",
        "{workspaceRoot}/infra/**",
        "{workspaceRoot}/deploy/**",
        "{workspaceRoot}/nginx/**",
        "{workspaceRoot}/docker-compose*.yml",
        "{workspaceRoot}/Dockerfile.agent-tooling",
        "{workspaceRoot}/apps/sensor-ingestion/Dockerfile",
        "{workspaceRoot}/.gitleaks.toml",
        "{workspaceRoot}/.github/manifests/postgres-image.json"
      ],
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/adapter-fs.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/adapter-ts.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/bundle-budget-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/doc-staleness-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/event-contracts-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/fe-dto-parity-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/infrastructure-policy-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/kernel-dead-wire-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/lint-rules-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/module-facts.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/module-schemas-source.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/rust-runtime-safety-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/rust-source.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/rust-test-files.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/security-boundary-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/security-boundary-adapter.nats.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/shell-script.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/sql-migration-safety-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/tenant-scoping-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/test-gap-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/typeorm-entity-schema-adapter.test.ts",
          "npx ts-node --project tools/gates/tsconfig.json tools/aria-adapters/workflow-shell-safety-adapter.test.ts"
        ]
      }
    }
  }
}
