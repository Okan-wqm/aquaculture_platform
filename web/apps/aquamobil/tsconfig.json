{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@aquaculture/shared-ui": ["../../shared-ui/src"],
      "@aquaculture/farm-shared": ["../../../libs/farm-shared/src"],
      "@aquaculture/shared-contracts": ["../../../libs/shared-contracts/src"],
      "@aquaculture/feeding-contracts": ["../../../libs/feeding-contracts/src"],
      "@aquaculture/feeding-contracts/*": ["../../../libs/feeding-contracts/src/*"]
    },
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "../../../node_modules",
    "src/pwa/messaging-sw.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
