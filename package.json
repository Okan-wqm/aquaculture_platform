{
  "name": "aquaculture-platform",
  "version": "1.0.0",
  "description": "Enterprise Multi-Tenant Aquaculture Platform with Microservices Architecture",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "platform/libs/*",
    "web/apps/*",
    "web/shared-ui",
    "web/shell",
    "web/modules/*",
    "mcp/*",
    "tools/executors/cargo"
  ],
  "scripts": {
    "dev": "node tools/toolchain/run.mjs nx run-many --target=serve --all",
    "dev:backend": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=gateway-api,farm-service,config-service,sensor-service,auth-service,alert-engine,billing-service,hr-service,hydroponics-service,notification-service",
    "dev:backend:minimal": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=gateway-api,auth-service,config-service,farm-service --parallel=4",
    "dev:backend:core": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=gateway-api,auth-service,config-service,farm-service,sensor-service --parallel=5",
    "dev:web": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=shell,dashboard,farm-module,admin-panel,tenant-admin,hr-module,sensor-module,hydroponics-module",
    "build": "node tools/toolchain/run.mjs nx affected --target=build",
    "build:all": "node tools/toolchain/run.mjs nx run-many --target=build --all",
    "build:web": "node tools/toolchain/run.mjs nx run-many --target=build --projects=shared-ui,shell,dashboard,farm-module,admin-panel,tenant-admin,hr-module,sensor-module,hydroponics-module",
    "test": "node tools/toolchain/run.mjs nx affected --target=test",
    "test:all": "node tools/toolchain/run.mjs nx run-many --target=test --all",
    "test:e2e:water-chemistry": "npm --prefix e2e run test:water-chemistry",
    "test:e2e:mobile": "npm --prefix e2e run test:mobile",
    "lint": "node tools/toolchain/run.mjs nx affected --target=lint",
    "lint:all": "node tools/toolchain/run.mjs nx run-many --target=lint --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "node tools/scripts/type-check-all.mjs",
    "affected:graph": "node tools/toolchain/run.mjs nx affected:graph",
    "graph": "node tools/toolchain/run.mjs nx graph",
    "prepare": "husky install",
    "docker:build": "docker buildx bake --load",
    "docker:build:backend": "docker buildx bake backend --load",
    "docker:build:backend:simple": "npm run build:backend && docker buildx bake backend-simple --load",
    "docker:build:frontend": "npm run build:web && docker buildx bake frontend --load",
    "docker:build:push": "docker buildx bake --push",
    "docker:fast": "npm run build:backend && docker buildx bake backend-simple --load --parallel",
    "docker:fast:service": "node tools/toolchain/run.mjs nx build $npm_config_service && docker buildx bake $npm_config_service-simple --load",
    "docker:affected": "ts-node --project scripts/service-catalog/tsconfig.json scripts/service-catalog/run-nx-group.ts --group backend --target build && docker buildx bake backend-simple --load",
    "docker:up": "docker compose up -d",
    "docker:up:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:up:watch": "docker compose -f docker-compose.watch.yml up --watch",
    "docker:down": "docker compose down",
    "docker:down:watch": "docker compose -f docker-compose.watch.yml down",
    "docker:logs": "docker compose logs -f",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "infra:logs": "docker compose -f docker-compose.infra.yml logs -f",
    "local:auth": "node tools/toolchain/run.mjs nx serve auth-service",
    "local:farm": "node tools/toolchain/run.mjs nx serve farm-service",
    "local:sensor": "node tools/toolchain/run.mjs nx serve sensor-service",
    "local:alert": "node tools/toolchain/run.mjs nx serve alert-engine",
    "local:billing": "node tools/toolchain/run.mjs nx serve billing-service",
    "local:hr": "node tools/toolchain/run.mjs nx serve hr-service",
    "local:hydroponics": "node tools/toolchain/run.mjs nx serve hydroponics-service",
    "local:gateway": "node tools/toolchain/run.mjs nx serve gateway-api",
    "dev:local": "npm run infra:up && concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"sleep 10 && npm run dev:web\"",
    "dev:fast": "npm run infra:up && npm run dev:backend",
    "build:backend": "ts-node --project scripts/service-catalog/tsconfig.json scripts/service-catalog/run-nx-group.ts --group backend --target build",
    "build:frontend": "ts-node --project scripts/service-catalog/tsconfig.json scripts/service-catalog/run-nx-group.ts --group frontend --target build",
    "build:full": "npm run build:backend && npm run build:frontend",
    "watch": "npm run infra:up && concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run watch:backend\" \"npm run watch:frontend\"",
    "watch:backend": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=gateway-api,auth-service,config-service,farm-service,sensor-service,hr-service,hydroponics-service --parallel=7",
    "watch:frontend": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=shell,tenant-admin,farm-module --parallel=3",
    "start:auth": "node tools/toolchain/run.mjs nx serve auth-service",
    "start:services": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=config-service,farm-service,sensor-service,hr-service,hydroponics-service --parallel=5",
    "start:gateway": "node tools/toolchain/run.mjs nx serve gateway-api",
    "start:shell": "node tools/toolchain/run.mjs nx serve shell",
    "start:modules": "node tools/toolchain/run.mjs nx run-many --target=serve --projects=tenant-admin,farm-module --parallel=2",
    "start:backend": "concurrently -k -n \"auth,services,gateway\" -c \"green,blue,yellow\" \"npm run start:auth\" \"sleep 15 && npm run start:services\" \"sleep 25 && npm run start:gateway\"",
    "start:frontend": "concurrently -k -n \"shell,modules\" -c \"cyan,magenta\" \"npm run start:shell\" \"sleep 5 && npm run start:modules\"",
    "start:all": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"sleep 30 && npm run start:frontend\"",
    "schema:generate": "node tools/toolchain/run.mjs nx run-many --target=build --all --parallel=2",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "service-catalog:generate": "ts-node --project scripts/service-catalog/tsconfig.json scripts/service-catalog/generate-artifacts.ts",
    "service-catalog:check": "ts-node --project scripts/service-catalog/tsconfig.json scripts/service-catalog/generate-artifacts.ts --check",
    "codegen:schema-registry": "node --experimental-strip-types scripts/schema-registry/generate-init-schemas.ts",
    "graphql:validate-registry": "node scripts/graphql/validate-registry.mjs",
    "graphql:generate-registry-artifacts": "node scripts/graphql/generate-registry-artifacts.mjs",
    "apollo-router:check-fallback": "node scripts/apollo-router/check-router-static-fallback.mjs",
    "apollo-router:gateway-subgraphs": "node scripts/apollo-router/generate-gateway-subgraphs.mjs",
    "apollo-router:supergraph-config": "node scripts/apollo-router/generate-supergraph-config.mjs",
    "apollo-router:compose": "bash scripts/apollo-router/compose-supergraph.sh",
    "gql:validate-ops": "node scripts/ci/validate-graphql-operations.mjs",
    "gql:validate-ops:update": "node scripts/ci/validate-graphql-operations.mjs --update-baseline",
    "apollo-router:pentest-headers": "node scripts/apollo-router/router-header-stripping-pentest.mjs",
    "typeorm:verify-governed-fork": "node scripts/typeorm/verify-governed-fork.mjs",
    "review": "ts-node --project tools/gates/tsconfig.json tools/scripts/orchestrator-runner.ts",
    "review:farm": "npm run review -- --scope 'apps/farm-service/**'",
    "review:sensor": "npm run review -- --scope 'apps/sensor-service/**'",
    "review:hr": "npm run review -- --scope 'apps/hr-service/**'",
    "review:billing": "npm run review -- --scope 'apps/billing-service/**'",
    "review:gateway": "npm run review -- --scope 'apps/gateway-api/**'",
    "review:platform": "npm run review -- --scope '{libs,platform/libs}/**'",
    "review:web": "npm run review -- --scope 'web/**'",
    "audit:gdpr": "ts-node --project tools/gates/tsconfig.json .claude/agents-enterprise-v2/runners/gdpr-audit.ts",
    "audit:perf": "ts-node --project tools/gates/tsconfig.json .claude/agents-enterprise-v2/runners/perf-audit.ts",
    "findings:list": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry.ts list --state OPEN",
    "findings:list:all": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry.ts list",
    "findings:verify": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry.ts verify",
    "findings:add": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry.ts add",
    "findings:close": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry.ts close",
    "findings:sweep": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry.ts sweep",
    "findings:export": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry.ts export csv",
    "invariants:fast": "jest --config tests/invariants/jest.config.ts --maxWorkers=3 --selectProjects layer-1 layer-3 registry",
    "invariants:full": "jest --config tests/invariants/jest.config.ts --maxWorkers=3",
    "aria:compile": "PYTHONPATH=aria-kernel python3 -c \"from pathlib import Path; [compile(p.read_text(encoding='utf-8'), str(p), 'exec') for p in Path('aria-kernel').rglob('*.py') if '__pycache__' not in p.parts]\"",
    "aria:test:unit": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=aria-kernel python3 -m unittest discover aria-kernel -p '*test*.py'",
    "aria:docs:ssot": "jest --config tests/invariants/jest.config.ts --selectProjects layer-3 --runTestsByPath tests/invariants/aria-doc-runtime-ssot.spec.ts",
    "aria:acceptance": "PYTHONDONTWRITEBYTECODE=1 python3 tools/aria-acceptance/harness.py",
    "aria:burnin:observe": "PYTHONPATH=aria-kernel python3 -m aria_kernel autonomy burn-in observe",
    "aria:authority-hash": "ts-node --project tools/gates/tsconfig.json tools/gates/aria-authority-hash.ts",
    "aria:authority-hash:write": "ts-node --project tools/gates/tsconfig.json tools/gates/aria-authority-hash.ts --write",
    "aria:ci:all": "npm run aria:compile && npm run aria:test:unit && npm run invariants:fast",
    "test:bootstrap": "jest --config apps/db-migrate/jest.config.cts --runInBand --testPathPatterns bootstrap-from-scratch",
    "test:tenant-clone": "jest --config e2e/jest.config.ts --runInBand --testPathPatterns tenant-clone-parity",
    "test:schema-invariants": "jest --config e2e/jest.config.ts --runInBand --testPathPatterns schema-invariants",
    "gates:banned-phrase": "ts-node --project tools/gates/tsconfig.json tools/gates/banned-phrase.ts",
    "gates:apollo-csrf": "node scripts/ci/check-apollo-csrf-prevention.mjs",
    "gates:dependency-policy": "node scripts/ci/check-dependency-policy.mjs",
    "gates:messaging-tenant-routing": "node scripts/ci/check-messaging-tenant-entity-routing.mjs",
    "gates:aquamobil-messaging-cache-keys": "node scripts/ci/check-aquamobil-messaging-cache-keys.mjs",
    "gates:aquamobil-messaging-contracts": "node scripts/ci/check-aquamobil-messaging-contracts.mjs",
    "gates:graphql-contracts": "node scripts/ci/check-graphql-contract-drift.mjs",
    "gates:production-licenses": "node scripts/ci/check-production-licenses.mjs",
    "gates:auth-db-ownership": "node scripts/ci/check-auth-db-ownership.mjs",
    "gates:migration-sql": "ts-node --project tools/gates/tsconfig.json tools/gates/migration-sql-lint.ts",
    "gates:clippy-affected": "ts-node --project tools/gates/tsconfig.json tools/gates/clippy-affected.ts",
    "gates:clippy-affected:test": "ts-node --project tools/gates/tsconfig.json tools/gates/clippy-affected.spec.ts",
    "gates:commit-msg:test": "ts-node --project tools/gates/tsconfig.json tools/gates/commit-msg-validator.spec.ts",
    "gates:finding-registry:test": "ts-node --project tools/gates/tsconfig.json tools/gates/finding-registry-store.spec.ts",
    "hooks:install": "git config core.hooksPath .husky && echo \"git hooks active: $(git config --get core.hooksPath)\"",
    "gates:debt-plan:repin": "ts-node --project tools/gates/tsconfig.json tools/gates/repin-debt-plan.ts",
    "gates:plan-coverage:test": "ts-node --project tools/gates/tsconfig.json tools/gates/plan-coverage-witness.spec.ts",
    "gates:banned-phrase:test": "ts-node --project tools/gates/tsconfig.json tools/gates/banned-phrase.spec.ts",
    "gates:lint-baseline:test": "ts-node --project tools/gates/tsconfig.json tools/lint-gates/lint-gates.spec.ts && ts-node --project tools/gates/tsconfig.json tools/lint-gates/custom-rules.spec.ts && ts-node --project tools/gates/tsconfig.json tools/lint-gates/eslintrc-flat-parity.spec.ts",
    "toolchain:check": "node tools/toolchain/check-versions.mjs",
    "gates:tools-typecheck": "tsc -p tools/gates/tsconfig.json --noEmit",
    "csp:render": "node scripts/security/render-csp.mjs --write --target all",
    "csp:check": "node scripts/security/render-csp.mjs --check --target all",
    "gates:csp-render": "npm run csp:check",
    "gates:geospatial-browser-bundle": "node scripts/ci/check-geospatial-browser-bundle.mjs",
    "gates:tier-claim": "ts-node --project tools/gates/tsconfig.json tools/gates/tier-claim-lint.ts",
    "gates:deletion-witness": "ts-node --project tools/gates/tsconfig.json tools/gates/main-deletion-witness.ts",
    "gates:migration-deletion-witness": "ts-node --project tools/gates/tsconfig.json tools/gates/migration-deletion-witness.ts",
    "gates:entity-diff-witness": "ts-node --project tools/gates/tsconfig.json tools/gates/entity-diff-witness.ts",
    "gates:migration-immutability-witness": "ts-node --project tools/gates/tsconfig.json tools/gates/migration-immutability-witness.ts",
    "gates:type-check-spec": "ts-node --project tools/gates/tsconfig.json tools/gates/type-check-spec.ts",
    "gates:signals-manifest": "node scripts/ci/validate-signals-manifest.ts",
    "gates:criticality-manifest": "node scripts/ci/validate-criticality-manifest.ts",
    "gates:gha-sha-pin": "ts-node --project tools/gates/tsconfig.json tools/gates/gha-sha-pin.ts",
    "gates:required-status-checks": "ts-node --project tools/gates/tsconfig.json tools/gates/required-status-checks.ts",
    "gates:required-status-checks:live": "npm run gates:required-status-checks -- --live",
    "gates:schema-drift-registration": "ts-node --project tools/gates/tsconfig.json tools/gates/schema-drift-registration.ts",
    "gates:sens-enterprise-validation": "ts-node --project tools/gates/tsconfig.json tools/gates/sens-enterprise-validation.ts",
    "gates:sens-enterprise-validation:self-test": "npm run gates:sens-enterprise-validation -- --self-test",
    "gates:root-ssot-stabilization": "jest --config tests/invariants/jest.config.ts --runTestsByPath tests/invariants/stabilization-manifest.spec.ts tests/invariants/toolchain-config-ssot.spec.ts",
    "validate:required-secrets": "node scripts/ci/validate-secrets-manifest.ts",
    "smoke:nats-messaging-acl:static": "node scripts/nats/messaging-acl-smoke.mjs --mode static",
    "smoke:nats-messaging-acl:external": "node scripts/nats/messaging-acl-smoke.mjs --mode live",
    "smoke:nats-messaging-acl": "bash scripts/nats/messaging-acl-smoke-harness.sh",
    "gates:all": "npm run toolchain:check && npm run service-catalog:check && npm run gates:tools-typecheck && npm run gates:csp-render && npm run gates:geospatial-browser-bundle && npm run gates:banned-phrase && npm run gates:migration-sql && npm run gates:tier-claim && npm run gates:type-check-spec && npm run gates:schema-drift-registration && npm run gates:signals-manifest && npm run gates:criticality-manifest && npm run gates:required-status-checks && npm run gates:root-ssot-stabilization",
    "ripple": "npx ts-node --project tools/ripple-tracer/tsconfig.json tools/ripple-tracer/cli.ts",
    "aria": "cd aria-kernel && PYTHONPATH=. python3 -m aria_kernel --tools-dir ../aria-tools cycle run --workspace-root .. --cycle-id aria-$(date -u +%Y%m%dT%H%M%SZ)",
    "aria:index": "cd aria-kernel && PYTHONPATH=. python3 -m aria_kernel --tools-dir ../aria-tools agent-network index --workspace-root ..",
    "aria:gaps": "cd aria-kernel && PYTHONPATH=. python3 -m aria_kernel --tools-dir ../aria-tools capability-gap detect --workspace-root .. --cycle-id aria-manual",
    "aria:requests": "cd aria-kernel && PYTHONPATH=. python3 -m aria_kernel --tools-dir ../aria-tools agent-invocations list",
    "factory:reset:dry": "node --experimental-strip-types tools/factory-reset/factory-reset.ts --dry-run",
    "factory:reset:execute": "FACTORY_RESET_ALLOWED=1 node --experimental-strip-types tools/factory-reset/factory-reset.ts --execute",
    "gates:farm-service": "ts-node --project tools/gates/tsconfig.json tools/gates/farm-service-enterprise-guardrails.ts",
    "gates:enterprise-closure": "ts-node --project tools/gates/tsconfig.runtime.json tools/gates/enterprise-closure.ts",
    "quality:closure-run": "node tools/quality/quality.mjs closure-run --profile gates-all",
    "quality:format-scope:generate": "node tools/quality/quality.mjs format-scope generate",
    "quality:format-scope:check": "node tools/quality/quality.mjs format-scope check"
  },
  "dependencies": {
