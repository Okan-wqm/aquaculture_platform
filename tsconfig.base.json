      "@aquaculture/backend-common/pagination": ["libs/backend-common/src/pagination/index.ts"],
      "@aquaculture/backend-common/quota": ["libs/backend-common/src/quota/index.ts"],
      "@aquaculture/backend-common/redis": ["libs/backend-common/src/redis/index.ts"],
      "@aquaculture/backend-common/resilience": ["libs/backend-common/src/resilience/index.ts"],
