{
  "bootstrap_action": {
    "id": "SOURCE_CONTROL_WORKSPACE_V1",
    "inputs": {
      "node-version": {
        "required": true
      }
    },
    "invocation_name": "Setup source-control workspace",
    "path": ".github/actions/setup-source-control-workspace/action.yml",
    "steps": [
      {
        "name": "Setup Node.js",
        "uses": "actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e",
        "with": {
          "cache": "npm",
          "node-version": "${{ inputs.node-version }}"
        }
      },
      {
        "name": "Install immutable workspace dependencies",
        "run": "npm ci --ignore-scripts --no-audit --prefer-offline --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000",
        "shell": "bash"
      }
    ],
    "uses": "./.github/actions/setup-source-control-workspace",
    "with": {
      "node-version": "${{ env.NODE_VERSION }}"
    }
  },
  "checkout_profile": {
    "kind": "EVENT_HEAD_V1",
    "runner": "ubuntu-latest",
    "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
    "with": {
      "fetch-depth": 0,
      "persist-credentials": false,
      "ref": "${{ github.event.pull_request.head.sha || github.sha }}"
    }
  },
  "leaf_jobs": [
    {
      "commands": [
        {
          "id": "FINDING_REGISTRY_AUTHORITY_TEST_V1",
          "name": "Verify finding registry mutation authority",
          "npm_script": "test:finding-registry-authority"
        }
      ],
      "execution_identity": {
        "kind": "NO_COMMAND_CREDENTIALS_V1"
      },
      "job": "finding-registry-store",
      "role": "FINDING_REGISTRY_AUTHORITY_TEST_V1",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 20,
      "workflow": ".github/workflows/ci-full.yml"
    },
    {
      "commands": [
        {
          "id": "AUTOMATION_PUBLICATION_PUBLISHER_TYPECHECK_V1",
          "name": "Verify automation publication publisher types",
          "npm_script": "gates:automation-publication-publisher-typecheck"
        },
        {
          "id": "AUTOMATION_PUBLICATION_ADMISSION_TEST_V1",
          "name": "Verify automation publication admission",
          "npm_script": "test:automation-publication-admission"
        },
        {
          "id": "SOURCE_CONTROL_PLANE_TEST_V1",
          "name": "Verify source control plane",
          "npm_script": "test:source-control-plane"
        }
      ],
      "execution_identity": {
        "kind": "NO_COMMAND_CREDENTIALS_V1"
      },
      "job": "source-control-contracts",
      "role": "SOURCE_CONTROL_CONTRACTS_V1",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 25,
      "workflow": ".github/workflows/ci-full.yml"
    },
    {
      "commands": [
        {
          "id": "FINDING_WRITER_PREFLIGHT_V1",
          "name": "Verify finding writer preflight",
          "npm_script": "findings:writer-preflight"
        },
        {
          "id": "CAPABILITY_SOURCE_INVENTORY_STATIC_V1",
          "name": "Verify committed capability source inventory",
          "npm_script": "gates:capability-source-inventory:static"
        },
        {
          "id": "SOURCE_FINDING_INVENTORY_STATIC_V1",
          "name": "Verify committed source finding attestations",
          "npm_script": "gates:source-finding-inventory:static"
        }
      ],
      "execution_identity": {
        "kind": "NO_COMMAND_CREDENTIALS_V1"
      },
      "job": "source-inventory-static",
      "role": "SOURCE_INVENTORY_STATIC_CI_V1",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 10,
      "workflow": ".github/workflows/ci-full.yml"
    },
    {
      "commands": [
        {
          "id": "CAPABILITY_INTEGRATION_EVIDENCE_LIVE_V1",
          "name": "Verify capability integration evidence",
          "npm_script": "gates:capability-integration-evidence:live"
        }
      ],
      "execution_identity": {
        "command_env": {
          "GITHUB_TOKEN": "${{ github.token }}"
        },
        "kind": "GITHUB_READ_TOKEN_V1",
        "permissions": {
          "actions": "read",
          "checks": "read",
          "contents": "read",
          "pull-requests": "read"
        }
      },
      "job": "capability-integration-evidence",
      "role": "CAPABILITY_INTEGRATION_EVIDENCE_V1",
      "runs_on": "ubuntu-latest",
      "timeout_minutes": 10,
      "workflow": ".github/workflows/ci-full.yml"
    }
  ],
  "schema": "SourceControlLeafCatalogV1",
  "workflow_closure": [
    {
      "path": ".github/workflows/ci-full.yml",
      "permissions": {
        "contents": "read"
      }
    }
  ]
}
