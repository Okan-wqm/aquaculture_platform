{
  "name": "farm-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/farm-service/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:service"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/farm-service"],
      "defaultConfiguration": "production",
      "options": {
        "command": "bash tools/build/build-service.sh farm-service"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "farm-service:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "farm-service:build:development"
        },
        "production": {
          "buildTarget": "farm-service:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/farm-service/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/farm-service/jest.config.ts"
      }
    },
    "test:integration": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}-integration"],
      "options": {
        "jestConfig": "apps/farm-service/jest.integration.config.ts",
        "runInBand": true
      }
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}-e2e"],
      "options": {
        "jestConfig": "apps/farm-service/jest.e2e.config.ts",
        "runInBand": true
      }
    },
    "coverage": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/farm-service/jest.config.ts",
        "codeCoverage": true
      }
    }
  }
}
