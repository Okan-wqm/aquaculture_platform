{
  "$schema": "aqua/github-required-status-checks/v1",
  "schema_version": 1,
  "repository": "Okan-wqm/aquaculture_platform",
  "branch": "main",
  "finding_ids": ["EDGE-CRITICAL-001", "INFRA-CRITICAL-044", "INFRA-HIGH-084"],
  "branch_protection": {
    "enforce_admins": true
  },
  "required_status_checks": {
    "strict": true,
    "contexts": ["sens-enterprise-summary", "merge-gate", "aria-merge-authority", "build-status"]
  },
  "ci_affected_required_path_filters": [
    "sens-api-gateway/**",
    "Cargo.toml",
    "Cargo.lock",
    "crates/**",
    "tools/executors/cargo/**",
    "tools/backup-ssh-broker/**",
    "tools/gates/**",
    "infrastructure/scripts/**",
    ".github/workflows/**",
    ".github/manifests/**",
    "tests/**",
    "package.json",
    "package-lock.json"
  ],
  "workflow_contracts": [
    {
      "workflow": ".github/workflows/ci-affected.yml",
      "contexts": [
        {
          "context": "sens-enterprise-summary",
          "job_id": "sens-enterprise-summary",
          "requires_jobs": [
            "detect-changes",
            "install",
            "lint",
            "type-check",
            "test",
            "sensor-service-gates",
            "sens-api-gateway-rust",
            "sens-enterprise-validation",
            "build"
          ],
          "required_markers": [
            "if: always()",
            "Fail on skipped, cancelled or failed Sens dependencies",
            "needs.sens-api-gateway-rust.result",
            "needs.sens-enterprise-validation.result"
          ]
        },
        {
          "context": "merge-gate",
          "job_id": "merge-gate",
          "requires_jobs": [
            "detect-changes",
            "install",
            "lint",
            "type-check",
            "test",
            "build",
            "sensor-service-gates",
            "sens-api-gateway-rust",
            "sens-enterprise-validation"
          ],
          "required_markers": ["Assert required PR checks"]
        }
      ]
    },
    {
      "workflow": ".github/workflows/aria-merge-authority.yml",
      "contexts": [
        {
          "context": "aria-merge-authority",
          "job_id": "aria-merge-authority",
          "requires_jobs": [],
          "required_markers": [
            "npm run aria:compile",
            "test_merge_authority_invariants.py",
            "npm run gates:required-status-checks",
            "npm run aria:docs:ssot"
          ]
        }
      ]
    },
    {
      "workflow": ".github/workflows/ci-full.yml",
      "contexts": [
        {
          "context": "build-status",
          "job_id": "build-status",
          "requires_jobs": [
            "lint-and-typecheck",
            "test",
            "build",
            "generate-sri-hashes",
            "deploy-ssot-gates",
            "security-scan",
            "license-check"
          ],
          "required_markers": ["name: build-status", "if: always()", "All critical checks passed"]
        }
      ]
    }
  ],
  "live_verification": {
    "command": "npm run gates:required-status-checks:live",
    "expected": "GitHub main branch protection exists, admin enforcement is enabled, strict mode is true, and required status check contexts match required_status_checks.contexts."
  }
}
