# =============================================================================
# Aquaculture Platform - Environment Variables
# Copy this file to .env and update values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgres://aquaculture:${DB_PASSWORD}@localhost:5432/aquaculture

# -----------------------------------------------------------------------------
# Per-service Database Passwords (SEC-015)
# Used by 00-init-schemas.sh to create per-service DB roles.
# If left empty, random passwords are generated at first DB init.
# For production, set these explicitly and store them securely.
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SERVICE_DB_PASS=
FARM_SERVICE_DB_PASS=
SENSOR_SERVICE_DB_PASS=
BILLING_SERVICE_DB_PASS=
HR_SERVICE_DB_PASS=
ALERT_SERVICE_DB_PASS=
ADMIN_SERVICE_DB_PASS=
GATEWAY_SERVICE_DB_PASS=
NOTIFICATION_SERVICE_DB_PASS=
HYDROPONICS_SERVICE_DB_PASS=
CONFIG_SERVICE_DB_PASS=
EVENT_STORE_SERVICE_DB_PASS=

# -----------------------------------------------------------------------------
# Service Identity
# -----------------------------------------------------------------------------
# Shared v2 service-identity keyring. Use real random secrets outside examples.
# SERVICE_IDENTITY_SIGNING_KID selects the active outbound signing key for
# gateway-api/config-service calls; event-store validates inbound callers and
# tenant scope from keyring entries.
SERVICE_IDENTITY_KEYRING={"keys":[{"kid":"platform-signing-v1","secret":"CHANGE_ME_64_CHAR_RANDOM","status":"active"},{"kid":"event-store-farm-v1","secret":"CHANGE_ME_64_CHAR_RANDOM","status":"active","callers":["farm-service"],"audiences":["event-store-service"],"tenantScopePolicy":"tenant-bound"},{"kid":"event-store-admin-v1","secret":"CHANGE_ME_64_CHAR_RANDOM","status":"active","callers":["admin-api-service"],"audiences":["event-store-service"],"tenantScopePolicy":"all-tenants"}]}
SERVICE_IDENTITY_SIGNING_KID=platform-signing-v1
SERVICE_IDENTITY_SIGNING_SECRET=local-dev-only-change-me

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# -----------------------------------------------------------------------------
# NATS Configuration
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here-min-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Service Encryption
# -----------------------------------------------------------------------------
CONFIG_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_RANDOM_VALUE
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_RANDOM_VALUE

# -----------------------------------------------------------------------------
# Farm Environmental Monitoring
# -----------------------------------------------------------------------------
# Keep disabled until company provider configuration is provisioned.
FARM_ENVIRONMENT_MONITORING_ENABLED=false
# Must match the dedicated key used for any existing legacy Sentinel rows.
SENTINEL_HUB_ENCRYPTION_KEY=CHANGE_ME_EXISTING_SENTINEL_KEY
MET_NORWAY_APPLICATION_NAME=AquaSaaS-Local/1.0
MET_NORWAY_CONTACT=https://example.invalid/operations
MET_NORWAY_FROST_CLIENT_ID=

# -----------------------------------------------------------------------------
# MinIO / S3 Configuration
# Used for file storage (documents, images, etc.)
# -----------------------------------------------------------------------------
MINIO_USER=minioadmin
MINIO_PASSWORD=your-minio-password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-password
MINIO_BUCKET=aquaculture
MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# SMTP Configuration (for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@aquaculture.local

# -----------------------------------------------------------------------------
# Container Registry (for production)
# -----------------------------------------------------------------------------
REGISTRY=ghcr.io/your-org
VERSION=latest

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Application URLs (for frontend configuration)
# -----------------------------------------------------------------------------
API_URL=http://localhost:3000
APP_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=true

# -----------------------------------------------------------------------------
# MFA & WebAuthn Configuration
# -----------------------------------------------------------------------------
# MFA encryption key for TOTP secret storage (AES-256-GCM)
# In production, this MUST be set or auth-service will crash on startup.
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# WebAuthn Relying Party ID (domain without protocol/port)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AquaCulture Platform

# -----------------------------------------------------------------------------
# MQTT Broker Configuration
# -----------------------------------------------------------------------------
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT Authentication Secret (required in production)
# Used to authenticate requests from Mosquitto go-auth plugin to sensor-service
# Generate with: openssl rand -hex 32
MQTT_AUTH_SECRET=change-me-to-a-strong-random-secret

# MQTT service account credentials (for sensor-service to connect to Mosquitto)
# Generate password: openssl rand -base64 32
# Generate hash: use MqttAuthService.hashPassword() with HTTP_MODE_ITERATIONS
MQTT_SENSOR_SERVICE_PASSWORD=
MQTT_SENSOR_SERVICE_HASH=
MQTT_BACKEND_SERVICE_HASH=

# -----------------------------------------------------------------------------
# Edge Device Provisioning
# -----------------------------------------------------------------------------
# Public URL for edge devices to download installer script and activate
# For local development: Use your LAN IP (run 'ipconfig' to find it)
# For production: Use your public domain (e.g., https://api.yourdomain.com)
PROVISIONING_API_BASE_URL=http://localhost:3000

# MQTT broker host for generic-Linux edge devices: a bare host name or IPv4
# address, no scheme or port. Devices always connect on 8883 over TLS
# (ADR-048 DEC-10.1); sensor-service refuses to start with anything else.
# Unset, it is the host name of PROVISIONING_API_BASE_URL.
# For local development: Use your LAN IP (same as above)
# For production: Use your public MQTT domain (e.g., mqtt.yourdomain.com)
MQTT_PUBLIC_BROKER_HOST=localhost

# Suderra OS edge channel (ADR-048; contracts/suderra-edge/v1). All or nothing:
# leave every SUDERRA_EDGE_* empty to run without Suderra OS provisioning;
# set some but not all and sensor-service refuses to boot.
# Signing keys, one per purpose: ed25519:<epoch>:<64 hex seed>, or <NAME>_FILE
# pointing at a secret file. They stay in service secrets until the P2 KMS
# signer (EDGE-HIGH-119). Dev/CI keys come from Suderra-OS scripts/gen-dev-keys.sh.
SUDERRA_EDGE_PROVISIONING_SIGNING_KEY=
SUDERRA_EDGE_CONFIG_INTEGRITY_SIGNING_KEY=
SUDERRA_EDGE_RBAC_MANIFEST_SIGNING_KEY=
SUDERRA_EDGE_DEVICE_LIFECYCLE_SIGNING_KEY=
SUDERRA_EDGE_COMMAND_SIGNING_KEY=
# The fleet-root-signed trust-anchors bundle (DSSE JSON) and the fleet-root
# public keys it verifies against: <epoch>:<base64 32-byte key>[,...]
SUDERRA_EDGE_TRUST_ANCHORS=
SUDERRA_EDGE_FLEET_ROOT_KEYS=
# The platform actor commands are signed as, and its RBAC policy window.
SUDERRA_EDGE_PLATFORM_ACTOR_ID=
SUDERRA_EDGE_RBAC_POLICY_VERSION=
SUDERRA_EDGE_RBAC_NOT_BEFORE=
SUDERRA_EDGE_RBAC_EXPIRES_AT=
# The release provisioned: https URL template with {version} and {asset}.
SUDERRA_EDGE_RELEASE_URL_TEMPLATE=
SUDERRA_EDGE_AGENT_VERSION=
# Device-facing broker host (8883 TLS only) and the https api_url agents activate on.
SUDERRA_EDGE_MQTT_HOST=
SUDERRA_EDGE_API_URL=
SUDERRA_EDGE_RESERVATION_TTL_MINUTES=30

# GitHub repository for edge-agent binary downloads
# Format: owner/repo (e.g., Okan-wqm/aquaculture_platform)
EDGE_AGENT_GITHUB_REPO=Okan-wqm/aquaculture_platform

# Provisioning token validity (hours)
PROVISIONING_TOKEN_HOURS=24
