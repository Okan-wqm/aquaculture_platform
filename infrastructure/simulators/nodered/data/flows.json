[
    {
        "id": "flow1",
        "type": "tab",
        "label": "Sensor Simulator",
        "disabled": false,
        "info": "Three sensors, each publishing on its own issued broker principal (ADR-047; device contract: sensorprotocols/mqtt-protocol.md).\n\nA broker node connects as SIM_<SENSOR>_MQTT_USERNAME (client ID and username) with SIM_<SENSOR>_MQTT_PASSWORD, and its output publishes to SIM_<SENSOR>_MQTT_TOPIC. Set them from the credential the device page issues (infrastructure/simulators/docker-compose.simulators.yml)."
    },
    {
        "id": "broker-water-quality",
        "type": "mqtt-broker",
        "name": "Platform broker (water quality sensor)",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "${SIM_WATER_QUALITY_MQTT_USERNAME}",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "closeTopic": "",
        "closePayload": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": ""
    },
    {
        "id": "inject-water-quality",
        "type": "inject",
        "z": "flow1",
        "name": "Every 5 seconds",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 160,
        "y": 100,
        "wires": [
            [
                "generate-water-quality"
            ]
        ]
    },
    {
        "id": "generate-water-quality",
        "type": "function",
        "z": "flow1",
        "name": "Generate Water Quality Data",
        "func": "const vary = (val, pct) => +(val + (Math.random() - 0.5) * 2 * val * pct).toFixed(2); msg.payload = { timestamp: new Date().toISOString(), ph: vary(7.2, 0.05), temperature: vary(28.5, 0.03), dissolved_oxygen: vary(6.8, 0.05), salinity: vary(32.1, 0.02), turbidity: vary(4.2, 0.1), ammonia: vary(0.02, 0.15) }; return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 100,
        "wires": [
            [
                "publish-water-quality",
                "show-water-quality"
            ]
        ]
    },
    {
        "id": "publish-water-quality",
        "type": "mqtt out",
        "z": "flow1",
        "name": "Publish Water Quality",
        "topic": "${SIM_WATER_QUALITY_MQTT_TOPIC}",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "broker-water-quality",
        "x": 650,
        "y": 100,
        "wires": []
    },
    {
        "id": "show-water-quality",
        "type": "debug",
        "z": "flow1",
        "name": "Show Data",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "x": 630,
        "y": 160,
        "wires": []
    },
