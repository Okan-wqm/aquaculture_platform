{
  "name": "admin-panel",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/modules/admin-panel/src",
  "projectType": "application",
  "tags": ["scope:web", "type:app", "module-federation:remote"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "web/modules/admin-panel",
        "command": "npm run dev"
      },
      "dependsOn": ["shared-ui:build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "web/modules/admin-panel",
        "command": "npm run build"
      },
      "dependsOn": ["shared-ui:build"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "web/modules/admin-panel",
        "command": "npm run preview"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "web/modules/admin-panel",
        "command": "npm run lint"
      }
    },
    "test": {
      "dependsOn": ["shared-ui:build"]
    },
    "openapi-client": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/web/modules/admin-panel/src/services/generated/admin-api.ts"],
      "inputs": ["{workspaceRoot}/apps/admin-api-service/openapi.json"],
      "options": {
        "command": "npx openapi-typescript apps/admin-api-service/openapi.json -o web/modules/admin-panel/src/services/generated/admin-api.ts"
      },
      "dependsOn": ["admin-api-service:openapi"]
    }
  },
  "implicitDependencies": ["shared-ui"]
}
