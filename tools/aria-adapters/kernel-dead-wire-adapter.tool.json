{
  "tool_id": "kernel-dead-wire-adapter",
  "kind": "adapter",
  "version": "1.0.0",
  "status": "SHADOW",
  "declared_scope": ["aria-kernel/aria_kernel/**/*.py", "aria-kernel/aria_kernel/data/*.json"],
  "output_schema": {
    "type": "object",
    "required": ["observations", "findings", "read_paths", "evidence_sources"]
  },
  "fixture_set": "tools/aria-adapters/fixtures/kernel-dead-wire-adapter",
  "health_thresholds": {
    "max_cost_units": 4000
  },
  "default_input": {
    "roots": ["aria-kernel/aria_kernel"]
  },
  "allowed_read_globs": [
    "aria-kernel/aria_kernel/**/*.py",
    "aria-kernel/aria_kernel/data/*.json",
    "tools/aria-adapters/fixtures/kernel-dead-wire-adapter/**"
  ],
  "forbidden_read_globs": [
    ".claude/**",
    ".git/**",
    "agent-workspace/**",
    ".aria-poc/**",
    "aria-tools/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "build/**",
    "tmp/**"
  ],
  "claim_types": ["kernel_dead_wire"],
  "rules": {
    "policy_key_never_read": {
      "claim_type": "wrong_code",
      "severity_cap": "MEDIUM",
      "defect_claim": "A kernel policy file declares a tunable that no kernel module reads, so setting it changes nothing.",
      "premises": [
        "The cited key is declared in aria-kernel/aria_kernel/data/*.json as an operator tunable.",
        "No kernel module reads the key, directly or through a loader that iterates the policy block."
      ]
    },
    "cli_verb_never_routed": {
      "claim_type": "wrong_code",
      "severity_cap": "MEDIUM",
      "defect_claim": "A kernel CLI subcommand parses but no branch dispatches it, so invoking it does nothing.",
      "premises": [
        "The cited subcommand is registered on the kernel CLI parser.",
        "No dispatch branch or handler mapping runs code for the subcommand."
      ]
    }
  },
  "owner": "platform",
  "runner": {
    "type": "subprocess",
    "argv": [
      "npx",
      "ts-node",
      "--project",
      "tools/gates/tsconfig.json",
      "tools/aria-adapters/kernel-dead-wire-adapter.ts"
    ],
    "cwd": ".",
    "timeout_ms": 180000,
    "stdin_json": true
  },
  "freshness_window_hours": 168,
  "parse_window_signature": "sha256:a6ec9ab9569735c09e6258cdb50be6ba61091b82962a604fb3f086dc6d083f1d",
  "schema_version": 1
}
