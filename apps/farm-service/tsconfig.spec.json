{
  // PROC-MEDIUM-012 closed by PR-44 — the exclude block (added in
  // PR-35 to keep the integration/e2e suites out of the unit-test
  // gate while their domain-model drift was unaddressed) has been
  // removed now that batch-lifecycle, tank-operations, and the
  // race-conditions e2e are re-derived against the current Batch /
  // Species / TankBatch / OutboxPublisher contracts. The auxiliary
  // suites are back in the strict-tsc gate along with the rest of
  // the farm-service spec sources.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.integration.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    // `*.e2e-spec.ts` suffix'i `*.spec.ts` glob'una TAKILMAZ (`-spec` vs
    // `.spec`), o yüzden bu dosyalar strict-tsc kapısının dışında kalıyordu —
    // ts-jest ise onları derliyor. Asimetri kapatıldı.
    "src/**/*.e2e-spec.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    // Day-one baseline reset folded historical 178xxx migration behaviour
    // into 1800000000000-Baseline. These specs import deleted migration
    // classes by design and are kept only as archaeological context.
    //
    // NOTE: an exclude here hides a file from `tsc` ONLY — ts-jest still
    // compiles whatever the jest testMatch selects. That asymmetry is what let
    // `code-sequences-schema-alignment.postgres.spec.ts` sit in the integration
    // target while importing a migration class that no longer exists: the
    // strict-tsc gate reported green and the suite could never run. That spec
    // is deleted rather than excluded — git history is the archaeological
    // record; an uncompilable file inside a test target is not.
    "src/database/migrations/__tests__/**/*.spec.ts"
  ]
}
