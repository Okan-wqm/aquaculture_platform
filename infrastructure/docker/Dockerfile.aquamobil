# =============================================================================
# AquaMobil PWA - Dockerfile
# Mobile-first Progressive Web App for field data entry
#
# Uses monorepo-relative paths so that shared libs (libs/farm-shared) are
# resolved identically to local development via vite alias.
# =============================================================================

# Build stage
# M-06: Pin base image to exact version for reproducible builds and to prevent
# silent security regressions from upstream tag mutations
FROM node:22.13.1-alpine3.20 AS builder

# Preserve monorepo directory structure so ../../../libs/ resolves correctly
WORKDIR /monorepo/web/apps/aquamobil

ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    NPM_CONFIG_FETCH_TIMEOUT=300000 \
    NPM_CONFIG_FUND=false

# Copy only aquamobil package files (standalone, no workspace deps needed)
# Explicit lockfile copy (no glob) — build fails if package-lock.json is missing (SEC-015)
COPY web/apps/aquamobil/package.json web/apps/aquamobil/package-lock.json ./

# Install dependencies with lockfile enforcement (SEC-015)
RUN npm ci --ignore-scripts

# Copy aquamobil source
COPY web/apps/aquamobil ./

# Copy shared libs required at build time
COPY libs/farm-shared /monorepo/libs/farm-shared
# shared-contracts is path-aliased in vite.config (@aquaculture/shared-contracts ->
# ../../../libs/shared-contracts/src), NOT npm-installed — so its SOURCE must be in
# the build context like farm-shared, else `vite build` fails: "Could not load
# /monorepo/libs/shared-contracts/src" (the aquamobil PWA imports
# MESSAGING_MEDIA_MIME_ALLOWLIST from it). See ORPHAN-MEDIUM-130.
COPY libs/shared-contracts /monorepo/libs/shared-contracts

# Patch konsta package.json to add root "." export (needed for Vite/Rollup)
RUN node -e " \
  const fs = require('fs'); \
  const p = './node_modules/konsta/package.json'; \
  if (fs.existsSync(p)) { \
    const pkg = JSON.parse(fs.readFileSync(p,'utf8')); \
    if (!pkg.exports || !pkg.exports['.']) { \
      pkg.exports = { '.': { types: './react/konsta-react.d.ts', require: './react/cjs/konsta-react.js', import: './react/esm/konsta-react.js' }, ...pkg.exports }; \
      fs.writeFileSync(p, JSON.stringify(pkg,null,2)); \
      console.log('Patched konsta'); \
    } \
  } \
" --input-type=commonjs

# Build aquamobil
RUN npx vite build

# =============================================================================
# Production stage - Nginx
# =============================================================================
# M-06: Pin nginx to exact version for reproducible builds and security
FROM nginx:1.27.3-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx config + the security-headers snippet it includes (SEC-MEDIUM-052).
# The include path (/etc/nginx/snippets/security-headers.conf) must match the
# `include` directives in aquamobil.conf, or nginx fails to start.
COPY infrastructure/docker/nginx/aquamobil.conf /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/nginx/snippets/security-headers.conf /etc/nginx/snippets/security-headers.conf

# Copy built files
COPY --from=builder /monorepo/web/apps/aquamobil/dist /usr/share/nginx/html

# D17-DF-001: Run as non-root using built-in nginx user (aligned with Dockerfile.frontend pattern)
# Pre-create nginx temp directories (nginx needs these at startup)
RUN mkdir -p /var/cache/nginx/client_temp \
             /var/cache/nginx/proxy_temp \
             /var/cache/nginx/fastcgi_temp \
             /var/cache/nginx/uwsgi_temp \
             /var/cache/nginx/scgi_temp && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --head http://127.0.0.1:80/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
