{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "eslint-plugin-aquaculture",
  "projectType": "library",
  "root": "tools/eslint-rules",
  "sourceRoot": "tools/eslint-rules",
  "tags": ["scope:tooling", "type:tooling"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": ["{workspaceRoot}/tools/eslint-rules/dist"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      },
      "cache": true
    }
  }
}
