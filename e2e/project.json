{
  "name": "@aquaculture/e2e-tests",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "e2e",
  "projectType": "application",
  "tags": ["scope:e2e", "type:test"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "eslint e2e/global-setup.ts e2e/global-teardown.ts e2e/jest.config.ts e2e/playwright.config.ts e2e/playwright.water-chemistry.config.ts e2e/fixtures/**/*.ts e2e/helpers/**/*.ts e2e/tests/*.ts",
          "eslint e2e/tests/integration/**/*.ts",
          "eslint e2e/tests/modules/farm/**/*.ts",
          "eslint e2e/tests/modules/hr/**/*.ts",
          "eslint e2e/tests/modules/sensor/**/*.ts",
          "eslint e2e/tests/modules/tenant-admin/**/*.ts",
          "eslint e2e/tests/security/**/*.ts",
          "eslint e2e/tests/water-chemistry/**/*.ts",
          "eslint e2e/tests/workflow/**/*.ts"
        ]
      }
    }
  }
}
