    "types": ["jest", "node"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "target": "ES2021",
    "module": "commonjs"
  },
  "include": [
    "helpers/**/*.ts",
    "tests/**/*.ts"
  ]
}
