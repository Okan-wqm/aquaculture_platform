#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Pre-push gates — Batch #345 (operations completion of the Batch #343
# clippy-affected gate landing).
#
# WHY pre-push (not pre-commit):
#
# `cargo clippy` re-compiles the whole crate before running lints
# (~30-60s warm, more cold). Pre-commit fires on every commit; on a
# busy dev cycle that adds up. Pre-push fires once per push regardless
# of how many commits the push contains. Clippy is the right check at
# the right time at this hook layer.
#
# WHY the gate is enforce-mode (not advisory):
#
# The auditor's MEDIUM-029 recommendation was "Tier-2 make-it-automatic
# — per-diff gate". Advisory-only would let new violations land on the
# remote without operator-visible signal. Enforce-mode at push time is
# the architectural completion of the Batch #343 gate's intent.
#
# WHY pre-push refs (not staged):
#
# git provides `<remote> <url>` on stdin and the local SHA + remote SHA
# pairs on each line. We compute the affected file set across the FULL
# range being pushed (origin/main...HEAD) so a multi-commit push is
# evaluated as one diff — same semantic as a CI PR check.

GATE_TS_NODE="./node_modules/.bin/ts-node"
GATE_TSCONFIG="--project tools/gates/tsconfig.json"

# Resolve the base ref. If `origin/main` is fetchable, use it; otherwise
# fall back to the upstream-tracking ref. If neither is available
# (detached/orphan branch), skip the gate gracefully — there's no
# meaningful diff range to scan.
BASE_REF=""
if git rev-parse --verify --quiet origin/main >/dev/null; then
  BASE_REF="origin/main"
elif git rev-parse --verify --quiet "@{upstream}" >/dev/null 2>&1; then
  BASE_REF="@{upstream}"
fi

if [ -z "$BASE_REF" ]; then
  echo "pre-push: no base ref resolvable (origin/main or upstream); skipping clippy-affected gate."
  exit 0
fi

"$GATE_TS_NODE" $GATE_TSCONFIG tools/gates/clippy-affected.ts --mode=range "$BASE_REF" HEAD || exit 1
