{
  "$schema": "aria/risk-policy/v1",
  "schema_version": 1,
  "policy_id": "aria-enterprise-risk-policy",
  "base_branch": "main",
  "merge_method": "squash",
  "auto_merge_candidate_lanes": ["L1"],
  "blocked_globs": [
    "**/.env*",
    "**/*secret*",
    "**/*secret*/**",
    "**/*credential*",
    "**/*credential*/**",
    "**/*private-key*",
    "**/*private-key*/**",
    "**/*pricing*",
    "**/*pricing*/**",
    "**/*billing*",
    "**/*billing*/**",
    "apps/billing-service/**",
    "infrastructure/terraform/**"
  ],
  "lanes": {
    "L1": {
      "reason_code": "docs_and_new_unit_tests_low_risk",
      "entries": [
        { "glob": "docs/**/*.md", "allowed_statuses": ["A", "M"] },
        { "glob": "apps/**/__tests__/**", "allowed_statuses": ["A"] },
        { "glob": "libs/**/__tests__/**", "allowed_statuses": ["A"] },
        { "glob": "web/**/__tests__/**", "allowed_statuses": ["A"] },
        { "glob": "apps/**/src/**/*.spec.ts", "allowed_statuses": ["A"] },
        { "glob": "libs/**/src/**/*.spec.ts", "allowed_statuses": ["A"] },
        { "glob": "web/**/src/**/*.spec.ts", "allowed_statuses": ["A"] }
      ],
      "disallowed_status_lane": "L2"
    },
    "L2": {
      "reason_code": "runtime_behavior_supervised",
      "globs": [
        "apps/**/src/**",
        "web/**/src/**",
        "libs/**/src/**",
        "platform/libs/**/src/**",
        "sens-api-gateway/src/**",
        "package.json",
        "nx.json",
        "tsconfig*.json",
        "**/*.config.*",
        "**/project.json",
        "**/Dockerfile"
      ]
    },
    "L3": {
      "reason_code": "control_plane_or_policy_approval",
      "globs": [
        ".github/**",
        ".claude/**",
        "CLAUDE.md",
        "**/CLAUDE.md",
        "**/AGENTS.md",
        "*.md",
        "aria-kernel/**",
        "tools/**",
        "e2e/**",
        "tests/**",
        "**/invariants/**",
        "docs/aria/**",
        "docs/reviews/**",
        "docs/plans/**",
        "docs/adr/**",
        "docs/api/**",
        "docs/security/**",
        "docs/compliance/**",
        "docs/evidence/**",
        "docs/release/**",
        "docs/releases/**",
        "docs/runbooks/aria-*.md",
        "docs/DEPLOY.md",
        "docs/architecture/edge-release-provisioning-ota.md",
        "docs/architecture/farm-enterprise-ssot.md",
        "docs/runbooks/database-restore-drill.md",
        "docs/runbooks/edge-gateway-rc4-operator.md",
        "docs/runbooks/farm-outbox-inbox-migration.md",
        "docs/runbooks/product-audit-invocation.md",
        "**/__tests__/integration/**",
        "**/__tests__/e2e/**",
        "**/__tests__/contract/**",
        "**/*.integration.spec.ts",
        "**/*.postgres.spec.ts",
        "**/*.contract.spec.ts",
        "**/*.e2e-spec.ts",
        "**/*.invariant.spec.ts",
        "**/*-invariants.spec.ts",
        "libs/migration-harness/**",
        "apps/admin-api-service/src/__tests__/contract-validation.spec.ts",
        "apps/sensor-service/src/edge-device/__tests__/agent-io-config-v2.spec.ts",
        "apps/sensor-service/src/edge-device/__tests__/edge-device.resolver.permissions.spec.ts",
        "apps/sensor-service/src/ingestion/__tests__/mqtt-listener.service.spec.ts",
        "web/modules/farm-module/src/pages/water-chemistry/**/*.spec.ts",
        "web/modules/farm-module/src/pages/water-chemistry/**/*.spec.tsx",
        "**/package-lock.json",
        "**/npm-shrinkwrap.json",
        "**/yarn.lock",
        "**/pnpm-lock.yaml",
        "**/Cargo.lock",
        "**/poetry.lock",
        "**/Pipfile.lock",
        "**/uv.lock",
        "**/go.sum"
      ]
    }
  },
  "codeowners_lane": "L3"
}
