#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Pre-commit gates — Phase 2 of
# docs/plans/2026-04-17-agentic-post-audit-consolidation-plan.md.
#
# Each gate fails the commit independently. migration-sql-lint only
# scans files that are actually staged AND path-matches a migration
# layout, so it is a no-op on non-migration commits.
#
# Future Phase 2 additions: tier-claim-lint (needs ts-morph), lint-staged.

npx ts-node --project tools/gates/tsconfig.json tools/gates/banned-phrase.ts --mode=staged || exit 1
npx ts-node --project tools/gates/tsconfig.json tools/gates/migration-sql-lint.ts --mode=staged || exit 1
