# 2026-04-30: CI/developer installs must fail on peer-dependency drift.
# This prevents hidden package-graph conflicts from reaching GitHub Actions
# through legacy or heuristic dependency resolution.
strict-peer-deps=true
fund=false

# 2026-06-10: registry network-resilience policy — SSOT.
# WHY: npm has NO retry on ECONNRESET by default; a single registry
# wobble killed 5 ci-affected jobs (exit 152 = npm network failure in
# the cache-miss fallback installs) across PRs #375/#376. The retry
# trio previously lived as inline flags duplicated in ci-full.yml +
# aria-kernel*.yml while ci-affected.yml had none — exactly the drift
# this file exists to prevent. Every npm invocation (all workflows,
# local dev, hooks) now inherits one policy from here; workflows keep
# only per-job execution flags (--ignore-scripts/--no-audit/
# --prefer-offline).
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
