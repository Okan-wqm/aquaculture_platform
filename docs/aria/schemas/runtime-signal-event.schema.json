{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aria/runtime-signal-event/v1",
  "title": "ARIA runtime signal event",
  "description": "One append-only event on <tools-root>/runtime-signals/events.jsonl (state surface runtime_signal_events), written only by aria-kernel/aria_kernel/runtime_signal_bridge.py (ARIA-MEDIUM-271). `observed` is one sighting, with the lead as it arrived; `resolved` and `quarantined` close the signal and never rewrite an observation. fold_runtime_signals derives the aria/runtime-signal/v1 record from them. aria-kernel/tests/test_runtime_signal_connectors.py fails the suite when the bridge and this schema drift apart.",
  "type": "object",
  "required": ["$schema", "schema_version", "event", "signal_id", "recorded_at"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "const": "aria/runtime-signal-event/v1"
    },
    "schema_version": {
      "const": 1
    },
    "event": {
      "enum": ["observed", "resolved", "quarantined"]
    },
    "signal_id": {
      "type": "string",
      "pattern": "^runtime-[0-9a-f]{16}$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "enum": ["sentry", "incident", "prod_log", "telemetry", "operator", "external_scanner"]
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "code_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "reported_severity": {
      "description": "Present only when the bridge capped an outside-authored source's claimed severity (UNTRUSTED_CONTENT_SOURCES): the value the source reported, kept beside the bounded severity.",
      "enum": ["low", "medium", "high", "critical"]
    },
    "trust_grade": {
      "const": "runtime_unverified"
    },
    "resolution_note": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Why a quarantined event closed the signal: the ref-law refusal."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": ["source", "service", "summary", "code_refs", "severity", "trust_grade"]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "required": ["resolution_note"]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "quarantined"
          }
        }
      },
      "then": {
        "required": ["reason"]
      }
    }
  ]
}
