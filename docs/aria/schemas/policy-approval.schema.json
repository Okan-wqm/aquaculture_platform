    "policy_id": { "type": "string", "minLength": 1 },
    "required_stages": {
      "type": "array",
      "items": { "enum": ["risk_owner", "exception_owner"] },
      "uniqueItems": true,
      "minItems": 2
    },
    "max_expiry_hours": { "type": "integer", "minimum": 1 },
    "separation_of_duties": { "const": true }
  },
  "additionalProperties": true
}
