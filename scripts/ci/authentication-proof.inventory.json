        "web/apps/aquamobil/src/services/__tests__/auth-ready-barrier-reset.spec.ts"
      ]
    },
    {
      "id": "auth-app",
      "lane": "types",
      "command": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--noEmit",
        "-p",
        "apps/auth-service/tsconfig.app.json"
      ],
      "cwd": "."
    },
    {
      "id": "auth-spec",
      "lane": "types",
      "command": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--noEmit",
        "-p",
        "apps/auth-service/tsconfig.spec.json"
      ],
      "cwd": "."
