# ─── MCP Farm Intelligence Server ─────────────────────────────
# GraphQL Gateway bağlantısı (farm-service verilerine erişim)
GATEWAY_URL=http://localhost:3000/graphql

# JWT token — stdio modunda kullanıcı kimlik doğrulaması
MCP_JWT_TOKEN=

# Transport modu: stdio (Claude Desktop/Code) veya sse (web entegrasyonu)
MCP_TRANSPORT=stdio

# SSE modu port (sadece MCP_TRANSPORT=sse iken)
MCP_PORT=3009

# Log seviyesi: debug | info | warn | error
MCP_LOG_LEVEL=info

# GraphQL istek timeout (ms)
MCP_REQUEST_TIMEOUT=30000
