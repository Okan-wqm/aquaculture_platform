{
  "$id": "aria/risk-policy/v1",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "policy_id",
    "base_branch",
    "merge_method",
    "auto_merge_candidate_lanes",
    "blocked_globs",
    "lanes",
    "codeowners_lane"
  ],
  "properties": {
    "$schema": { "const": "aria/risk-policy/v1" },
    "schema_version": { "const": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "base_branch": { "const": "main" },
    "merge_method": { "const": "squash" },
    "auto_merge_candidate_lanes": {
      "type": "array",
      "items": { "enum": ["L1", "L2", "L3"] },
      "uniqueItems": true
    },
    "blocked_globs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lanes": {
      "type": "object",
      "required": ["L1", "L2", "L3"]
    },
    "codeowners_lane": {
      "enum": ["L2", "L3"],
      "description": "Lane every CODEOWNERS-owned path is forced into; never L1, so no owned path is merged without its owner (ARIA-HIGH-187)."
    }
  },
  "additionalProperties": true
}
