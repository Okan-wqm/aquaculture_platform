{
  "displayName": "event-bus",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.ts$": ["ts-jest", {
      "tsconfig": {
        "target": "ES2021",
        "module": "commonjs",
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strict": true,
        "skipLibCheck": true
      }
    }]
  },
  "moduleFileExtensions": ["ts", "js", "json"],
  "rootDir": ".",
  "testMatch": ["**/__tests__/**/*.spec.ts"]
}
