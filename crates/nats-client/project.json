{
  "name": "nats-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "crates/nats-client/src",
  "tags": ["scope:rust", "type:crate", "layer:transport"],
  "targets": {
    "build": {
      "executor": "@aqua/cargo:run",
      "options": { "command": "build", "package": "nats-client", "release": false },
      "outputs": ["{workspaceRoot}/target/debug/libnats_client.rlib"],
      "cache": true
    },
    "build-release": {
      "executor": "@aqua/cargo:run",
      "options": { "command": "build", "package": "nats-client", "release": true },
      "outputs": ["{workspaceRoot}/target/release/libnats_client.rlib"],
      "cache": true
    },
    "test": {
      "executor": "@aqua/cargo:run",
      "options": { "command": "test", "package": "nats-client", "allFeatures": true },
      "cache": true
    },
    "lint": {
      "executor": "@aqua/cargo:run",
      "options": { "command": "clippy", "package": "nats-client", "args": ["--all-targets", "--all-features", "--", "-D", "warnings"] },
      "cache": true
    },
    "fmt-check": {
      "executor": "@aqua/cargo:run",
      "options": { "command": "fmt", "package": "nats-client", "args": ["--", "--check"] },
      "cache": true
    }
  }
}
