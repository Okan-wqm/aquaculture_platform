    },
    {
      "id": "nats-production-acl",
      "lane": "nats",
      "command": ["bash", "scripts/ci/test-nats-production-acl.sh"],
      "cwd": ".",
      "report": "artifacts/authentication-proof/nats-acl.json",
      "required_files": ["nats-production-acl.integration.spec.ts"]
