# CLAUDE-MEDIUM-011: .full-review/ is orchestrator state-file accumulation
# consumed by context-manager as read-only external memory. Each cycle
# produces new phase documents; the directory is never committed to keep
# prior-cycle state from poisoning future compaction runs.
.full-review/

# CLAUDE-MEDIUM-006: PreToolUse Agent dispatch gate audit log. Append-only
# per-session log; never committed.
.claude/agents/.dispatch-log.jsonl

# SEC-M05: vite-plugin-pwa dev-dist is a development-only service worker artifact.
# It must never be committed because it contains a GraphQL-caching SW that leaks
# authenticated responses if deployed to production.
web/apps/aquamobil/dev-dist/

# Security: block swarm/flow directory creation
.swarm/
.claude-flow/

# D14-SC-01: SRI hash map generated by CI — must not be committed (stale hashes break SRI)
web/shell/src/generated/remoteHashes.json
