# =============================================================================
# Aquaculture Platform - Microfrontend Dockerfile
# Serves pre-built Module Federation remotes via nginx
# =============================================================================

FROM nginx:alpine

# Install curl for health checks (wget not available in nginx:alpine by default)
RUN apk add --no-cache curl

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx config for microfrontends with CORS support
COPY infrastructure/docker/nginx/microfrontend.conf /etc/nginx/conf.d/default.conf

# Build argument for module path
ARG MODULE_PATH

# Copy pre-built dist folder
COPY ${MODULE_PATH}/dist /usr/share/nginx/html

# D17-DF-001: Run as non-root (aligned with Dockerfile.frontend pattern)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# Expose default HTTP port
EXPOSE 80

# Health check - verify nginx is responding
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:80/healthz || exit 1

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
