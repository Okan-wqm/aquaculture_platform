{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aria://packs/legal/schemas/case.schema.json",
  "title": "LegalCase",
  "description": "One case working set. caseId names the artifact directory under packs/legal/cases AND the case's intake directory under the cases root: one id, one pattern (ui/shared/legal-contract.ts LEGAL_CASE_ID_PATTERN), both sides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "title",
    "jurisdiction",
    "courtReference",
    "archiveRoot",
    "createdAt",
    "snapshotSha256",
    "adapterId",
    "adapterVersion",
    "runId",
    "cycleId"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ]
    },
    "courtReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "archiveRoot": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "cycleId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
