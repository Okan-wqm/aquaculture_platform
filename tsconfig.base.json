      "@aquaculture/backend-common/sensor": ["libs/backend-common/src/sensor/index.ts"],
      "@aquaculture/backend-common/compliance": ["libs/backend-common/src/compliance/index.ts"],
      "@aquaculture/backend-common/telemetry": ["libs/backend-common/src/telemetry/index.ts"],
      "@aquaculture/backend-common/tenant": ["libs/backend-common/src/tenant/index.ts"],
      "@aquaculture/backend-common/types": ["libs/backend-common/src/types/index.ts"],
      "@aquaculture/backend-common/utils": ["libs/backend-common/src/utils/index.ts"],
      "@aquaculture/backend-common/websocket": ["libs/backend-common/src/websocket/index.ts"],
      "@platform/event-contracts": ["libs/event-contracts/src/index.ts"],
      "@aquaculture/feeding-contracts": ["libs/feeding-contracts/src/index.ts"],
      "@platform/sensor-automation-types": ["libs/sensor-automation-types/src/index.ts"],
      "@platform/alarm-core": ["libs/alarm-core/src/index.ts"],
      "@platform/protocol-codec": ["libs/protocol-codec/src/index.ts"],
      "@platform/sensor-contracts": ["libs/sensor-contracts/src/index.ts"],
      "@platform/sensor-contracts/validators": ["libs/sensor-contracts/src/validators.ts"],
      "@platform/storage": ["libs/storage/src/index.ts"],
      "@platform/sdk": ["libs/sdk/typescript/src/index.ts"],
      "@platform/testing": ["libs/testing/src/index.ts"],
      "@aquaculture/testing": ["libs/testing/src/index.ts"],
      "@aquaculture/testing/vitest": ["libs/testing/src/vitest-test-policy.d.ts"],
      "@platform/event-bus": ["platform/libs/event-bus/src/index.ts"],
      "@platform/outbox": ["platform/libs/outbox/src/index.ts"],
      "@platform/cqrs": ["platform/libs/cqrs/src/index.ts"],
      "@platform/service-catalog": ["platform/libs/service-catalog/src/index.ts"],
      "@web/shared-ui": ["web/shared-ui/src/index.ts"],
      "@aquaculture/node-components": ["libs/node-components/src/index.ts"],
