{
  "name": "@aquaculture/shared-ui",
  "version": "1.0.0",
  "description": "Aquaculture Platform paylaşımlı UI kütüphanesi",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./federation/federationSharedConfig": {
      "types": "./src/federation/federationSharedConfig.ts",
      "import": "./src/federation/federationSharedConfig.ts"
    },
    "./styles": {
      "import": "./dist/styles/index.mjs",
      "require": "./dist/styles/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && node -e \"require('fs').writeFileSync('dist/package.json',JSON.stringify({name:'@aquaculture/shared-ui',version:'1.0.0',main:'index.js',module:'index.mjs',types:'index.d.ts'},null,2))\"",
    "build:types": "tsc --emitDeclarationOnly",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.0",
    "clsx": "^2.1.0",
    "graphql": "^16.8.0",
    "react-router-dom": "^6.21.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "aquaculture",
    "ui",
    "react",
    "components",
    "design-system"
  ],
  "author": "Aquaculture Platform Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aquaculture/platform.git",
    "directory": "web/shared-ui"
  },
  "publishConfig": {
    "access": "public"
  }
}
