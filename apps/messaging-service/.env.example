# =============================================================================
# Messaging Service Environment Variables
# =============================================================================

# Service
PORT=3000
NODE_ENV=development
SERVICE_NAME=messaging-service

# Database (PostgreSQL via PgBouncer)
DATABASE_HOST=localhost
DATABASE_PORT=6432
DATABASE_USER=aquaculture
DATABASE_PASSWORD=devpassword
DATABASE_NAME=aquaculture
DATABASE_SYNC=false
DATABASE_MIGRATIONS_RUN=false
DB_POOL_SIZE=10
DB_SSL=false

# Redis (dedicated DB index 3)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3

# NATS
NATS_URL=nats://localhost:4222

# MinIO (media storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aquaculture
MINIO_USE_SSL=false

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1d

# Rate Limiting
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL=60
THROTTLE_ENABLED=true

# GraphQL
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# CORS
CORS_ORIGINS=*

# Messaging-specific
MESSAGING_MEDIA_MAX_SIZE_MB=25
MESSAGING_TENANT_STORAGE_QUOTA_GB=10
MESSAGING_MESSAGE_MAX_LENGTH=4000
MESSAGING_IDEMPOTENCY_TTL_DAYS=7

# Trust proxy (behind nginx)
TRUST_PROXY=false
