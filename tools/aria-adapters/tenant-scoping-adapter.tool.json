{
  "tool_id": "tenant-scoping-adapter",
  "kind": "adapter",
  "version": "1.0.0",
  "status": "SHADOW",
  "declared_scope": [
    "apps/**/*.ts",
    "libs/**/*.ts",
    "platform/libs/**/*.ts"
  ],
  "output_schema": {
    "type": "object",
    "required": [
      "observations",
      "findings",
      "read_paths",
      "evidence_sources"
    ]
  },
  "fixture_set": "tools/aria-adapters/fixtures/tenant-scoping-adapter",
  "health_thresholds": {
    "max_cost_units": 3500
  },
  "default_input": {
    "roots": [
      "apps",
      "libs",
      "platform/libs"
    ],
    "includeRepositoryReadFindings": false
  },
  "allowed_read_globs": [
    "apps/**/*.ts",
    "libs/**/*.ts",
    "platform/libs/**/*.ts"
  ],
  "forbidden_read_globs": [
    ".claude/**",
    ".git/**",
    "agent-workspace/**",
    ".aria-poc/**",
    "aria-tools/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "build/**",
    "tmp/**"
  ],
  "claim_types": [
    "tenant_scoping"
  ],
  "owner": "platform",
  "runner": {
    "type": "subprocess",
    "argv": [
      "npx",
      "ts-node",
      "--project",
      "tools/gates/tsconfig.json",
      "tools/aria-adapters/tenant-scoping-adapter.ts"
    ],
    "cwd": ".",
    "timeout_ms": 180000,
    "stdin_json": true,
    "node_max_old_space_mb": 3072
  },
  "schema_version": 1
}
