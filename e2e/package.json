{
  "name": "@aquaculture/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test infrastructure for Aquaculture SaaS Platform",
  "scripts": {
    "test": "npm run test:security && npm run test:node",
    "test:security": "playwright test --project=security",
    "test:water-chemistry": "playwright test --config playwright.water-chemistry.config.ts --project=farm-water-chemistry",
    "test:mobile": "playwright test --config playwright.aquamobil.config.ts --project=aquamobil-mobile",
    "test:node": "jest --config jest.config.ts",
    "test:workflow": "jest --config jest.config.ts tests/workflow",
    "test:integration": "jest --config jest.config.ts tests/integration",
    "test:invariants": "jest --config jest.config.ts --testPathPattern='-invariants\\.spec\\.ts$'",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.12.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.1",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.23.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.0",
    "uuid": "^14.0.2"
  },
  "nx": {
    "includedScripts": []
  }
}
