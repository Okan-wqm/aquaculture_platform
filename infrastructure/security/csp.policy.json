{
  "version": 1,
  "directiveOrder": [
    "default-src",
    "script-src",
    "script-src-elem",
    "style-src",
    "style-src-elem",
    "worker-src",
    "img-src",
    "connect-src",
    "font-src",
    "frame-src",
    "object-src",
    "base-uri",
    "form-action"
  ],
  "directives": {
    "default-src": ["'self'"],
    "script-src": ["'self'", "https://cdn.jsdelivr.net"],
    "script-src-elem": ["'self'", "https://cdn.jsdelivr.net"],
    "style-src": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com", "https://cdn.jsdelivr.net"],
    "style-src-elem": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com", "https://cdn.jsdelivr.net"],
    "worker-src": ["'self'", "blob:"],
    "img-src": [
      "'self'",
      "data:",
      "blob:",
      "https://*.tile.openstreetmap.org",
      "https://server.arcgisonline.com",
      "https://*.basemaps.cartocdn.com"
    ],
    "connect-src": [
      "'self'",
      "wss:",
      "https://cdn.jsdelivr.net",
      "https://*.basemaps.cartocdn.com",
      "https://*.tile.openstreetmap.org"
    ],
    "font-src": ["'self'", "data:", "https://fonts.gstatic.com", "https://cdn.jsdelivr.net"],
    "frame-src": ["'self'"],
    "object-src": ["'none'"],
    "base-uri": ["'self'"],
    "form-action": ["'self'"]
  },
  "outputs": [
    {
      "target": "shell",
      "path": "web/shell/index.html",
      "kind": "html-meta"
    },
    {
      "target": "droplet-nginx",
      "path": "infrastructure/nginx/droplet.conf",
      "kind": "nginx-header"
    },
    {
      "target": "docker-nginx",
      "path": "infrastructure/docker/nginx/nginx.prod.conf",
      "kind": "nginx-header"
    },
    {
      "target": "legacy-nginx",
      "path": "nginx/nginx.conf",
      "kind": "nginx-header"
    }
  ]
}
