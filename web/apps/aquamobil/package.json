{
  "name": "@aquaculture/aquamobil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aquaculture Mobile PWA - Field Data Entry",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:quick": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:invariant": "vitest run --config vitest.config.ts src/pwa/__tests__/sw-build-artifact.invariant.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "node scripts/patch-konsta.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.10",
    "@tanstack/react-virtual": "^3.14.6",
    "clsx": "^2.1.0",
    "firebase": "^12.12.1",
    "graphql": "^16.12.0",
    "graphql-tag": "2.12.6",
    "idb-keyval": "^6.2.1",
    "konsta": "^3.1.4",
    "lucide-react": "0.469.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "6.30.4",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "fake-indexeddb": "6.2.5",
    "jsdom": "24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "3.2.4",
    "workbox-build": "^7.0.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
