# =============================================================================
# AquaMobil PWA - Dockerfile
# Mobile-first Progressive Web App for field data entry
# =============================================================================

# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Copy workspace packages
COPY web/shared-ui/package.json ./web/shared-ui/
COPY web/apps/aquamobil/package.json ./web/apps/aquamobil/

# Install dependencies
RUN npm ci --workspace=@aquaculture/shared-ui --workspace=@aquaculture/aquamobil || npm install

# Copy shared-ui source
COPY web/shared-ui ./web/shared-ui

# Build shared-ui
WORKDIR /app/web/shared-ui
RUN npm run build || echo "shared-ui build skipped"

# Copy aquamobil source
WORKDIR /app
COPY web/apps/aquamobil ./web/apps/aquamobil

# Build aquamobil
WORKDIR /app/web/apps/aquamobil
RUN npm run build

# =============================================================================
# Production stage - Nginx
# =============================================================================
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx config
COPY infrastructure/docker/nginx/aquamobil.conf /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=builder /app/web/apps/aquamobil/dist /usr/share/nginx/html

# Create non-root user
RUN adduser -D -g '' appuser && \
    chown -R appuser:appuser /usr/share/nginx/html && \
    chown -R appuser:appuser /var/cache/nginx && \
    chown -R appuser:appuser /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appuser /var/run/nginx.pid

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --head http://127.0.0.1:80/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
