# syntax=docker/dockerfile:1.4
# =============================================================================
# Aquaculture Platform - Backend Services Dockerfile
# Multi-stage build for NestJS microservices
# 
# Optimizations:
# - BuildKit cache mounts for npm and NX cache
# - Use with: DOCKER_BUILDKIT=1 docker build ...
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Base image with dependencies
# -----------------------------------------------------------------------------
# SECURITY: Pin base image by digest for immutable, reproducible builds.
# Tag mutations on Docker Hub can silently introduce vulnerabilities.
# To update: docker pull node:22.12.0-alpine3.20 && docker inspect --format='{{.RepoDigests}}' node:22.12.0-alpine3.20
FROM node:22.12.0-alpine3.20@sha256:40be63691f20f56b21e8e0e8e4d80f27b5a5ad45b82816e0a39d3e0e9aaab7fb AS base

# Install build dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./

# -----------------------------------------------------------------------------
# Stage 2: Dependencies installation
# -----------------------------------------------------------------------------
FROM base AS deps

# Install all dependencies (including devDependencies for build).
# 2026-04-30: Keep Docker dependency resolution peer-clean like CI.
# WHY: Apollo Server / NestJS and TypeORM supply-chain upgrades must fail at
# install time instead of being bypassed by --legacy-peer-deps.
RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    npm ci --ignore-scripts --no-audit

# -----------------------------------------------------------------------------
# Stage 3: Builder - Compile TypeScript
# -----------------------------------------------------------------------------
FROM deps AS builder

# Copy source code
# ARCH-015: Copying full monorepo source here. To reduce cache invalidation,
# use a .dockerignore that excludes other apps, or pass SERVICE_NAME earlier
# and copy only apps/${SERVICE_NAME} and its lib dependencies.
COPY apps/ ./apps/
COPY libs/ ./libs/
COPY platform/ ./platform/
COPY tools/ ./tools/

# Build argument for service name
ARG SERVICE_NAME

# Build the specific service using direct tsc compilation
# WHY: Webpack breaks NestJS decorator metadata. Direct tsc is correct and faster.
ENV NODE_OPTIONS="--max-old-space-size=2048"
RUN bash tools/build/build-service.sh ${SERVICE_NAME}

# -----------------------------------------------------------------------------
# Stage 4: Production dependencies only
# -----------------------------------------------------------------------------
FROM base AS prod-deps

# Skip prepare script (husky) in Docker.
# Production dependencies only with BuildKit cache mount and strict peers.
RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    npm ci --omit=dev --ignore-scripts --no-audit

# -----------------------------------------------------------------------------
# Stage 5: Production image
# -----------------------------------------------------------------------------
FROM node:22.12.0-alpine3.20@sha256:40be63691f20f56b21e8e0e8e4d80f27b5a5ad45b82816e0a39d3e0e9aaab7fb AS production

# Install curl for health checks and other utilities
RUN apk add --no-cache curl dumb-init

# Security: Run as non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001

WORKDIR /app

# Copy production dependencies with correct ownership (ARCH-001)
COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules

# Copy built application
ARG SERVICE_NAME
COPY --from=builder --chown=nestjs:nodejs /app/dist/apps/${SERVICE_NAME} ./dist

# Copy package.json for version info
COPY --chown=nestjs:nodejs package.json ./

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Health check - uses /health/live endpoint for liveness probe
# Increased start-period for NestJS bootstrap time
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:${PORT}/health/live || exit 1

# Switch to non-root user
USER nestjs

# Expose port
EXPOSE 3000

# Use dumb-init to handle signals properly for graceful shutdown
ENTRYPOINT ["dumb-init", "--"]

# Start the service
CMD ["node", "dist/main.js"]
