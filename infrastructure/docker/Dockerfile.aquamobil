# =============================================================================
# AquaMobil PWA - Dockerfile
# Mobile-first Progressive Web App for field data entry
# =============================================================================

# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy only aquamobil package files (standalone, no workspace deps needed)
# Explicit lockfile copy (no glob) — build fails if package-lock.json is missing (SEC-015)
COPY web/apps/aquamobil/package.json web/apps/aquamobil/package-lock.json ./

# Install dependencies with lockfile enforcement (SEC-015)
RUN npm ci --ignore-scripts

# Copy aquamobil source
COPY web/apps/aquamobil ./

# Patch konsta package.json to add root "." export (needed for Vite/Rollup)
RUN node -e " \
  const fs = require('fs'); \
  const p = './node_modules/konsta/package.json'; \
  if (fs.existsSync(p)) { \
    const pkg = JSON.parse(fs.readFileSync(p,'utf8')); \
    if (!pkg.exports || !pkg.exports['.']) { \
      pkg.exports = { '.': { types: './react/konsta-react.d.ts', require: './react/cjs/konsta-react.js', import: './react/esm/konsta-react.js' }, ...pkg.exports }; \
      fs.writeFileSync(p, JSON.stringify(pkg,null,2)); \
      console.log('Patched konsta'); \
    } \
  } \
" --input-type=commonjs

# Build aquamobil
RUN npx vite build

# =============================================================================
# Production stage - Nginx
# =============================================================================
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx config
COPY infrastructure/docker/nginx/aquamobil.conf /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# D17-DF-001: Run as non-root using built-in nginx user (aligned with Dockerfile.frontend pattern)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --head http://127.0.0.1:80/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
