{
  "tool_id": "fe-dto-parity-adapter",
  "kind": "adapter",
  "version": "1.0.0",
  "status": "SHADOW",
  "declared_scope": ["apps/**/dto/**/*.ts", "web/**/*.{ts,tsx}"],
  "output_schema": {
    "type": "object",
    "required": ["observations", "findings", "read_paths", "evidence_sources"]
  },
  "fixture_set": "tools/aria-adapters/fixtures/fe-dto-parity-adapter",
  "health_thresholds": {
    "max_cost_units": 6000
  },
  "default_input": {
    "backendRoots": ["apps"],
    "frontendRoots": ["web"]
  },
  "allowed_read_globs": ["apps/**/*.ts", "web/**/*.ts", "web/**/*.tsx"],
  "forbidden_read_globs": [
    ".claude/**",
    ".git/**",
    "agent-workspace/**",
    ".aria-poc/**",
    "aria-tools/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "build/**",
    "tmp/**"
  ],
  "claim_types": ["contract_parity"],
  "rules": {
    "hand_copied_dto_field_drift": {
      "claim_type": "wrong_code",
      "severity_cap": "HIGH",
      "defect_claim": "A frontend DTO hand-copied from a backend DTO has drifted, so the ValidationPipe strips or rejects fields and input is lost.",
      "premises": [
        "The frontend type is a copy of the cited backend DTO, sent to or read from the endpoint that DTO validates.",
        "The two field sets differ in a field the request or response actually carries."
      ]
    }
  },
  "owner": "platform",
  "runner": {
    "type": "subprocess",
    "argv": [
      "npx",
      "ts-node",
      "--project",
      "tools/gates/tsconfig.json",
      "tools/aria-adapters/fe-dto-parity-adapter.ts"
    ],
    "cwd": ".",
    "timeout_ms": 240000,
    "stdin_json": true
  },
  "freshness_window_hours": 168,
  "parse_window_signature": "sha256:96197733542447a341a65a4b142fc15a302cd870f93b499424f82f74af16abc4",
  "schema_version": 1
}
