      "required_files": [
        "web/shell/src/pages/auth/__tests__/LoginForm.spec.tsx",
        "web/shell/src/pages/auth/__tests__/AuthFormShell.spec.tsx",
        "web/shell/src/layouts/__tests__/AuthLayout.spec.tsx"
      ]
    },
    {
