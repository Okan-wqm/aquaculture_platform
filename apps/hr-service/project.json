{
  "name": "hr-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hr-service/src",
  "projectType": "application",
  "tags": [
    "scope:backend",
    "type:service"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/hr-service"
      ],
      "defaultConfiguration": "production",
      "options": {
        "command": "bash tools/build/build-service.sh hr-service"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "hr-service:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "hr-service:build:development"
        },
        "production": {
          "buildTarget": "hr-service:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/hr-service/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/hr-service/jest.config.ts"
      }
    }
  }
}
