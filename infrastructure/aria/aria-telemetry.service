# Plan 032 Faz 032e — one-shot Prometheus textfile export of the ARIA store.
# Paired with aria-telemetry.timer. Install:
#   cp infrastructure/aria/aria-telemetry.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now aria-telemetry.timer
[Unit]
Description=ARIA kernel telemetry export (Prometheus textfile)
After=network-online.target

[Service]
Type=oneshot
User=gharunner
Group=gharunner
WorkingDirectory=/var/aqua-saas
EnvironmentFile=-/etc/aria/aria.env
Environment=ARIA_REPO_ROOT=/var/aqua-saas
ExecStart=/var/aqua-saas/scripts/aria/aria-telemetry-textfile.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/node_exporter/textfile_collector /var/aqua-saas/aria-tools
